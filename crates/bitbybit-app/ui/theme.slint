// bitBybit design tokens — the dark navy administrative dashboard of the design specification. One fixed palette;
// Rust only sets the motion preference.

export global Theme {
    // ── Palette (specification)
    out property <color> app-bg: #111827;
    out property <color> workspace: #172235;
    out property <color> sidebar: #1B273A;
    out property <color> panel: #202C40;
    out property <color> text: #F5F7FA;
    out property <color> text-secondary: #A7B2C4;
    out property <color> text-muted: #77869B;
    out property <color> green: #16B88F;
    out property <color> cyan: #269FD4;
    out property <color> indigo: #575DAA;
    out property <color> amber: #E6A23C;
    out property <color> red: #DC6464;

    // ── Neutrals derived from the palette (controls on panels, lines, insets)
    out property <color> control: #27354B;
    out property <color> control-hover: #2F3F57;
    out property <color> control-press: #34465F;
    out property <color> divider: #2A374C;
    out property <color> inset: root.workspace;
    out property <color> scrim: #0B1120CC;

    // ── Roles
    out property <color> primary: root.green;
    out property <color> ok: root.green;
    out property <color> info: root.cyan;
    out property <color> warn: root.amber;
    out property <color> error: root.red;
    out property <color> focus: root.cyan;

    // ── Geometry
    out property <length> sidebar-width: 236px;
    out property <length> header-height: 68px;
    out property <length> gap: 16px;
    out property <length> pad: 18px;
    out property <length> radius-panel: 14px;
    out property <length> radius-card: 12px;
    out property <length> radius-control: 8px;
    out property <length> control-height: 34px;
    out property <length> control-height-s: 28px;
    out property <length> row-height: 48px;
    out property <length> content-max: 1800px;

    // ── Type (Poppins)
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-title: 15px;
    out property <length> font-page: 22px;
    out property <length> font-value: 26px;

    // ── Motion: off when Windows asks for reduced animations.
    in property <bool> reduce-motion;
    out property <duration> quick: root.reduce-motion ? 0ms : 120ms;
}
