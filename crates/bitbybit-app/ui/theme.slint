// bitBybit Liquid Glass design tokens. Colours are set from Rust (src/theme.rs) for the chosen look (dark, glass,
// light, custom); geometry, type and motion are fixed here so every component shares them.

export global Theme {
    // Look
    in property <bool> dark: true;
    in property <color> bg-top: #0D1420;
    in property <color> bg-bottom: #070B12;
    in property <color> glow-a: #388AFF29;
    in property <color> glow-b: #7A5CFF14;
    in property <color> glow-c: #21BFF20F;
    in property <color> glass: #FFFFFF0F;
    in property <color> glass-strong: #141D2BF0;
    in property <color> surface: #FFFFFF0B;
    in property <color> surface-hover: #FFFFFF14;
    in property <color> edge: #FFFFFF17;
    in property <color> highlight: #FFFFFF1F;
    in property <color> shadow: #00000073;
    in property <color> scrim: #0000008C;
    in property <color> text: #EBEDF3;
    in property <color> text-secondary: #97A3B4;
    in property <color> accent: #388AFF;
    in property <color> accent-hover: #5EA0FF;
    in property <color> accent-soft: #388AFF2E;
    in property <color> on-accent: #FFFFFF;
    in property <color> ok: #22C55E;
    in property <color> warn: #F59E0B;
    in property <color> error: #EF4444;

    // Geometry: concentric radii (outer = inner + padding) and an 4-px spacing grid.
    out property <length> radius-s: 8px;
    out property <length> radius-m: 12px;
    out property <length> radius-l: 18px;
    out property <length> radius-xl: 24px;
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;
    out property <length> control-height: 34px;

    // Type
    out property <length> font-caption: 12px;
    out property <length> font-body: 13px;
    out property <length> font-emphasis: 14px;
    out property <length> font-title: 16px;
    out property <length> font-page: 28px;

    // Motion: off when Windows asks for reduced animations.
    in property <bool> reduce-motion;
    out property <duration> quick: reduce-motion ? 0ms : 140ms;
    out property <duration> smooth: reduce-motion ? 0ms : 240ms;
}
