// bitBybit design tokens. Colours come from Rust (src/theme.rs) for the chosen look (dark, glass, light, custom);
// geometry, type and motion are fixed here so every component shares one system.
//
// Spacing: a 4-px grid. Radii are concentric (outer = inner + padding): dialog 22 > pane 18 > card 14 > field 10 >
// chip 6; controls are capsules. Type: one family (Inter), five sizes, weights 400/500/600/700.

export global Theme {
    // ── Look (from Rust)
    in property <bool> dark: true;
    in property <color> bg-top: #0B1A33;
    in property <color> bg-bottom: #050A12;
    in property <color> glow-a: #1FC6F233;
    in property <color> glow-b: #2F6BFF38;
    in property <color> glow-c: #14E0C812;
    in property <color> glass: #0E2140A8;
    in property <color> glass-strong: #0C1A31F7;
    in property <color> surface: #10223DB8;
    in property <color> surface-hover: #173058DB;
    in property <color> edge: #7FD8FF29;
    in property <color> highlight: #FFFFFF42;
    in property <color> shadow: #0000008C;
    in property <color> scrim: #02060DBD;
    in property <color> text: #EEF4FA;
    in property <color> text-secondary: #9DB2C9;
    in property <color> accent: #1FC6F2;
    in property <color> accent-hover: #62DBF8;
    in property <color> accent-soft: #1FC6F226;
    in property <color> on-accent: #03121A;
    in property <color> ok: #34D399;
    in property <color> warn: #FBBF24;
    in property <color> error: #F87171;

    // ── Derived surfaces (state layers over whatever is below)
    out property <color> text-tertiary: root.text-secondary.with-alpha(0.72);
    out property <color> hairline: root.dark ? #FFFFFF14 : #0B25451A;
    out property <color> fill-subtle: root.dark ? #FFFFFF0A : #0B25450A;
    out property <color> fill-hover: root.dark ? #FFFFFF12 : #0B254512;
    out property <color> fill-press: root.dark ? #FFFFFF1C : #0B25451C;
    out property <color> field: root.dark ? #020A1873 : #FFFFFFD9;
    out property <color> field-edge: root.dark ? #FFFFFF1F : #0B25452B;
    out property <color> focus-ring: root.accent.with-alpha(0.55);
    out property <color> info: root.accent;

    // ── Spacing (4-px grid)
    out property <length> space-2xs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 20px;
    out property <length> space-2xl: 24px;
    out property <length> space-3xl: 32px;

    // ── Radii
    out property <length> radius-xs: 6px;
    out property <length> radius-s: 8px;
    out property <length> radius-m: 10px;
    out property <length> radius-l: 14px;
    out property <length> radius-xl: 18px;
    out property <length> radius-2xl: 22px;

    // ── Sizes
    out property <length> control-height: 32px;
    out property <length> control-height-s: 28px;
    out property <length> control-height-l: 40px;
    out property <length> row-height: 44px;
    out property <length> sidebar-width: 216px;
    out property <length> content-max: 1280px;
    out property <length> reading-max: 760px;

    // ── Type
    out property <length> font-caption: 11px;
    out property <length> font-small: 12px;
    out property <length> font-body: 13px;
    out property <length> font-emphasis: 14px;
    out property <length> font-title: 15px;
    out property <length> font-page: 24px;
    out property <length> font-display: 26px;

    // ── Motion: off when Windows asks for reduced animations.
    in property <bool> reduce-motion;
    out property <duration> quick: root.reduce-motion ? 0ms : 120ms;
    out property <duration> smooth: root.reduce-motion ? 0ms : 220ms;
}
