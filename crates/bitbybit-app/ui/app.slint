// bitBybit main window — the dark navy administrative dashboard of the design specification: a fixed sidebar, a
// header panel (page title, search, notifications, settings), coloured summary cards and panels on a dark workspace.
// Every visible text comes from the pt-PT catalog through Tr.t(key); data comes from the broker. The AppWindow
// properties and callbacks are the Rust contract.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Spinner, Button, IconButton, Toggle, Check, TextField, Select, SegItem, Segmented, Slider, MenuEntry, MenuButton } from "controls.slint";
import { Scroller, Secondary, Body, Divider, Panel, PanelTitle, KpiCard, AreaChart, ActivityItem, ColumnLabel, TableHeader, TableRow, Badge, StatusDot, StatusBanner, EmptyState, Field, SettingRow, NavItem, NavGroup } from "components.slint";
import "assets/fonts/Poppins-Regular.ttf";
import "assets/fonts/Poppins-Medium.ttf";
import "assets/fonts/Poppins-SemiBold.ttf";
import "assets/fonts/Poppins-Bold.ttf";

export { Theme }

export global Tr {
    pure callback t(string) -> string;
}

export struct InterfaceRow {
    name: string,
    kind: string,
    status: string,
    addresses: string,
    vpn: bool,
    up: bool,
}

export struct DeviceRow {
    id: string,
    name: string,
    class: string,
    status: string,
    driver: string,
    problem: bool,
    can-restart: bool,
    can-enable: bool,
    can-disable: bool,
    can-uninstall: bool,
    can-change-driver: bool,
}

export struct DriverChoice {
    inf: string,
    title: string,
    detail: string,
    current: bool,
}

export struct AudioRow {
    id: string,
    name: string,
    flow: string,
    state: string,
    defaults: string,
    can-make-default: bool,
    volume: int,
    muted: bool,
    can-prefer: bool,
    can-force: bool,
}

export struct DisplayRow {
    name: string,
    connection: string,
    mode: string,
    edid: string,
    warning: string,
}

export struct FindingRow {
    level: int,
    severity: string,
    title: string,
    detail: string,
    evidence: string,
    actions: string,
    buttons: [string],
}

export struct CleanupItem { id: string, device: bool, title: string, detail: string, impact: string, risk: string, recommended: bool }
export struct StoreItem { inf: string, title: string, detail: string, used-by: string }
export struct UpdateItem { id: string, title: string, detail: string }
// A coloured summary card of the dashboard (real figures from src/view.rs).
export struct Kpi { title: string, value: string, note: string, page: int }
// One series of the dashboard chart: SVG path data in a 1000×300 box and its axis labels.
export struct ChartData { name: string, line: string, area: string, x-labels: [string], y-labels: [string], summary: string, empty: bool }
// A device on the shared network with its rules (Connectify-style card).
export struct ClientCard { mac: string, title: string, since: string, ip: string, allow-internet: bool, allow-local: bool, gaming: int, fixed: string }

// One box of the sharing diagram. kind: 0 Internet carrier, 1 VPN, 2 where it is shared, 3 a device.
export struct TopoNode { id: string, kind: int, title: string, detail: string, parent: int, x: length, y: length }

export struct ChangeRow {
    id: string,
    when: string,
    kind: string,
    description: string,
    status: string,
    scope: string,
    can-revert: bool,
}

// ─────────────────────────────────────────────────────────────── page pieces

// Three summary cards over a panel band, as in the specification (the band sits behind the lower part of the cards).
component KpiBand inherits Rectangle {
    height: 176px;
    Panel {
        x: 0;
        y: 54px;
        width: root.width;
        height: root.height - 54px;
    }
    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: 146px;
        padding-left: 28px;
        padding-right: 28px;
        spacing: Theme.gap;
        @children
    }
}

// One conclusion of the Realtek / DisplayPort analysis: severity, what was found, the evidence and what to do.
component FindingItem inherits Rectangle {
    in property <FindingRow> info;
    in property <bool> last;
    callback run(int);
    property <int> tone: root.info.level >= 2 ? 2 : (root.info.level == 1 ? 1 : 3);
    height: layout.preferred-height;
    if !root.last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
    layout := HorizontalLayout {
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: Theme.inset;
                Icon {
                    width: 18px;
                    height: 18px;
                    source: root.tone == 3 ? @image-url("assets/icons/info.svg") : @image-url("assets/icons/triangle-alert.svg");
                    tint: root.tone == 2 ? Theme.red : root.tone == 1 ? Theme.amber : Theme.cyan;
                }
            }
        }
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 10px;
                Text { text: root.info.title; font-size: Theme.font-title; font-weight: 600; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                VerticalLayout { alignment: start; Badge { text: root.info.severity; tone: root.tone; } }
            }
            Body { text: root.info.detail; color: Theme.text-secondary; }
            if root.info.evidence != "": Rectangle {
                border-radius: Theme.radius-control;
                background: Theme.inset;
                height: ev.preferred-height;
                ev := VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 3px;
                    Text { text: Tr.t("app.case.evidence"); font-size: Theme.font-small; font-weight: 600; color: Theme.text-muted; }
                    Text { text: root.info.evidence; font-size: Theme.font-small; color: Theme.text-secondary; wrap: word-wrap; }
                }
            }
            if root.info.actions != "": HorizontalLayout {
                spacing: 10px;
                Rectangle { width: 3px; border-radius: 1.5px; background: Theme.green; }
                Text { text: root.info.actions; font-size: Theme.font-small; font-weight: 500; color: Theme.text; wrap: word-wrap; }
            }
            if root.info.buttons.length > 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 2px;
                for label[i] in root.info.buttons: Button { text: label; size: 1; kind: i == 0 ? 1 : 0; clicked => { root.run(i); } }
            }
        }
    }
}

// An audio endpoint as a compact tile: what it is, its roles and state, volume and mute, and its actions.
component AudioTile inherits Rectangle {
    in property <AudioRow> info;
    callback make-default(string);
    callback set-volume(string, float);
    callback set-mute(string, bool);
    callback prefer(string);
    callback force(string);
    border-radius: Theme.radius-card;
    background: Theme.inset;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: root.info.defaults != "" ? Theme.green.with-alpha(0.18) : Theme.panel;
                Icon { source: @image-url("assets/icons/volume-2.svg"); tint: root.info.defaults != "" ? Theme.green : Theme.text-secondary; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.info.name; font-size: Theme.font-body; font-weight: 600; color: Theme.text; overflow: elide; }
                Text { text: root.info.flow; font-size: Theme.font-caption; color: Theme.text-muted; overflow: elide; }
            }
            if root.info.can-prefer || root.info.can-force: MenuButton {
                tooltip: Tr.t("app.more");
                entries: [
                    { label: Tr.t("app.audio.prefer"), icon: @image-url("assets/icons/circle-check.svg"), destructive: false, enabled: root.info.can-prefer },
                    { label: Tr.t("app.audio.force"), icon: @image-url("assets/icons/volume-2.svg"), destructive: false, enabled: root.info.can-force },
                ];
                activated(a) => {
                    if (a == 0) { root.prefer(root.info.id); }
                    if (a == 1) { root.force(root.info.id); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Badge { text: root.info.state; tone: 0; }
            if root.info.defaults != "": Badge { text: root.info.defaults; tone: 4; }
        }
        if root.info.volume >= 0: HorizontalLayout {
            spacing: 12px;
            Slider {
                value: root.info.volume;
                accessible-label: Tr.t("app.audio.volume");
                released(v) => { root.set-volume(root.info.id, v); }
            }
            Text { text: Math.round(root.info.volume) + "%"; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; width: 36px; }
            Toggle {
                text: Tr.t("app.audio.mute");
                checked: root.info.muted;
                toggled => { root.set-mute(root.info.id, self.checked); }
            }
        }
        if root.info.can-make-default: HorizontalLayout {
            alignment: start;
            Button { text: Tr.t("app.audio.makeDefault"); kind: 1; size: 1; clicked => { root.make-default(root.info.id); } }
        }
    }
}

// The live chain of the active share: carrier → (VPN) → hotspot or card → devices. Boxes can be dragged.
component ShareDiagram inherits Rectangle {
    in property <[TopoNode]> nodes;
    in property <length> canvas-height;
    in property <length> canvas-width;
    callback move(int, length, length);
    property <length> node-w: 180px;
    property <length> node-h: 58px;
    height: max(120px, root.canvas-height);
    border-radius: Theme.radius-card;
    background: Theme.inset;
    clip: true;
    accessible-role: groupbox;
    accessible-label: Tr.t("app.topo.title");
    Flickable {
        content-width: max(root.width, root.canvas-width);
        content-height: root.height;
        for n in root.nodes: Path {
            visible: n.parent >= 0;
            x: 0;
            y: 0;
            width: parent.content-width;
            height: root.height;
            viewbox-width: self.width / 1px;
            viewbox-height: self.height / 1px;
            stroke: n.kind == 3 ? Theme.text-muted : Theme.cyan;
            stroke-width: 1.5px;
            fill: transparent;
            MoveTo {
                x: (root.nodes[n.parent].x + root.node-w) / 1px;
                y: (root.nodes[n.parent].y + root.node-h / 2) / 1px;
            }
            CubicTo {
                control-1-x: (root.nodes[n.parent].x + root.node-w + 24px) / 1px;
                control-1-y: (root.nodes[n.parent].y + root.node-h / 2) / 1px;
                control-2-x: (n.x - 24px) / 1px;
                control-2-y: (n.y + root.node-h / 2) / 1px;
                x: n.x / 1px;
                y: (n.y + root.node-h / 2) / 1px;
            }
        }
        for n[i] in root.nodes: Rectangle {
            x: n.x;
            y: n.y;
            width: root.node-w;
            height: root.node-h;
            border-radius: Theme.radius-control;
            background: drag.pressed ? Theme.control-hover : Theme.panel;
            border-width: 1px;
            border-color: drag.has-hover ? Theme.cyan : Theme.divider;
            accessible-role: text;
            accessible-label: n.title + ", " + n.detail;
            drag := TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                moved => {
                    if (self.pressed) {
                        root.move(i, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }
            HorizontalLayout {
                padding: 10px;
                spacing: 10px;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: n.kind == 1 ? Theme.green.with-alpha(0.18) : n.kind == 3 ? Theme.control : Theme.cyan.with-alpha(0.18);
                    Icon {
                        tint: n.kind == 1 ? Theme.green : n.kind == 3 ? Theme.text-secondary : Theme.cyan;
                        source: n.kind == 0 ? @image-url("assets/icons/globe.svg")
                            : n.kind == 1 ? @image-url("assets/icons/shield-check.svg")
                            : n.kind == 2 ? @image-url("assets/icons/wifi.svg")
                            : @image-url("assets/icons/smartphone.svg");
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: n.title; font-size: Theme.font-small; font-weight: 600; color: Theme.text; overflow: elide; }
                    Text { text: n.detail; font-size: Theme.font-caption; color: Theme.text-muted; overflow: elide; }
                }
            }
        }
    }
}

// One device on the shared network and its rules. Edits stay local until "Aplicar" (with confirmation).
component ClientPanel inherits Rectangle {
    in property <ClientCard> info;
    callback apply(string, bool, bool, int, string);
    property <bool> internet: root.info.allow-internet;
    property <bool> local: root.info.allow-local;
    property <int> gaming: root.info.gaming;
    property <string> fixed: root.info.fixed;
    border-radius: Theme.radius-card;
    background: Theme.inset;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: Theme.panel;
                Icon { width: 18px; height: 18px; tint: Theme.cyan; source: @image-url("assets/icons/smartphone.svg"); }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.info.title; font-size: Theme.font-body; font-weight: 600; color: Theme.text; overflow: elide; }
                Text { text: root.info.since; font-size: Theme.font-caption; color: Theme.green; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: root.info.ip; font-size: Theme.font-body; font-weight: 600; color: Theme.text; horizontal-alignment: right; }
                Text { text: root.info.mac; font-size: Theme.font-caption; color: Theme.text-muted; horizontal-alignment: right; }
            }
        }
        HorizontalLayout {
            spacing: 24px;
            Toggle { text: Tr.t("app.client.internet"); checked <=> root.internet; }
            Toggle { text: Tr.t("app.client.local"); checked <=> root.local; }
            Rectangle { }
        }
        HorizontalLayout {
            spacing: 12px;
            Field {
                label: Tr.t("app.client.gaming");
                Select {
                    model: [Tr.t("app.client.gaming.off"), Tr.t("app.client.gaming.psn"), Tr.t("app.client.gaming.xbox"), Tr.t("app.client.gaming.nintendo")];
                    current-index <=> root.gaming;
                }
            }
            Field {
                label: Tr.t("app.client.fixed");
                TextField { placeholder-text: Tr.t("app.client.fixedAuto") + " (2–254)"; text <=> root.fixed; input-type: number; }
            }
            VerticalLayout {
                alignment: end;
                horizontal-stretch: 0;
                Button {
                    text: Tr.t("app.client.apply");
                    kind: 1;
                    clicked => { root.apply(root.info.mac, root.internet, root.local, root.gaming, root.fixed); }
                }
            }
        }
    }
}

// A modal dialog: scrim over the window, a centred panel.
component Modal inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }
    @children
}

// ─────────────────────────────────────────────────────────────── window

export component AppWindow inherits Window {
    in property <string> version;
    in property <string> about-version;
    in property <string> logs-text;
    in property <int> broker-state;
    in property <string> broker-message;
    in property <string> route-summary;
    in property <string> hidden-summary;
    in property <[InterfaceRow]> interfaces;
    in property <[DeviceRow]> devices;
    callback device-action(string, string);
    callback device-drivers(string, string);
    callback rescan();
    in property <string> driver-device-id;
    in property <string> driver-device-name;
    in property <[DriverChoice]> driver-choices;
    callback install-driver(string, string);
    callback rollback-driver(string);
    callback close-drivers();
    in property <string> devices-summary;
    in property <[AudioRow]> audio;
    in property <string> audio-subtitle;
    in property <string> audio-message;
    in property <[DisplayRow]> displays;
    in property <string> displays-summary;
    in property <bool> displays-failed;
    in property <[FindingRow]> findings;
    in property <string> diagnosis-summary;
    in property <bool> diagnosis-running;
    callback diagnose();
    callback run-finding-action(int, int);
    in property <[ChangeRow]> changes;
    in property <string> changes-message;
    callback revert(string);
    callback make-default(string);
    callback set-volume(string, float);
    callback set-mute(string, bool);
    callback restart-audio-services();
    in property <[CleanupItem]> cleanup-items;
    in property <[StoreItem]> store-items;
    in property <[UpdateItem]> update-items;
    in property <bool> updates-searched;
    in property <string> backups-text;
    in property <[string]> share-labels;
    in-out property <int> share-upstream;
    in property <[string]> share-target-labels;
    in-out property <int> share-downstream;
    in-out property <string> share-lan;
    // 0 Wi-Fi hotspot, 1 another network card (wired router), 2 Wi-Fi repeater.
    in-out property <int> share-mode;
    in property <bool> share-has-wifi: true;
    /// The connected Wi-Fi a repeater repeats ("" when the Wi-Fi is not connected).
    in property <string> share-repeater-source;
    in-out property <string> share-name: "bitBybit";
    in-out property <string> share-password;
    in-out property <bool> share-leak;
    in property <bool> share-upstream-vpn;
    in property <string> share-session;
    in-out property <bool> share-allow-internet: true;
    in-out property <bool> share-show-password;
    in-out property <int> share-tab;
    in property <int> share-clients;
    in property <string> share-sharing;
    callback share-mode-changed();
    // Proposal from the cards present (Internet source and how to share it) and the "new card" alert.
    in property <string> share-suggestion;
    in-out property <string> new-card-text;
    callback use-suggestion();
    in property <[TopoNode]> topo-nodes;
    in property <[ClientCard]> client-cards;
    callback client-apply(string, bool, bool, int, string);
    in property <length> topo-height;
    in property <length> topo-width;
    callback topo-move(int, length, length);
    callback share-upstream-changed();
    callback start-sharing();
    callback stop-sharing();
    in property <string> app-update-text;
    in property <bool> app-update-available;
    // 0 idle/up to date, 1 working, 2 a version is available, 3 failed.
    in property <int> app-update-state;
    in-out property <bool> update-dialog-visible;
    in property <string> update-version;
    in property <string> update-notes;
    callback dismiss-update();
    in-out property <bool> update-auto: true;
    callback check-app-update();
    callback export-logs();
    callback install-app-update();
    callback refresh-drivers();
    callback toggle-cleanup(string, bool, bool);
    callback toggle-update(string, bool);
    callback apply-cleanup();
    callback remove-package(string);
    callback search-updates();
    callback install-updates();
    callback prefer-endpoint(string);
    callback forget-profile();
    callback force-output(string);
    in property <string> audio-profile;
    in-out property <int> page: 8;
    in property <[Kpi]> kpis;
    in property <[ChartData]> charts;
    callback refresh();
    // Operation feedback (0 none, 1 working, 2 done, 3 failed) and the confirmation dialog.
    in property <int> op-state;
    in property <string> op-message;
    in property <bool> op-elevate;
    callback dismiss-op();
    callback relaunch-elevated();
    in property <bool> dialog-visible;
    in property <string> dialog-summary;
    in property <[string]> dialog-steps;
    in property <[string]> dialog-warnings;
    in property <[string]> dialog-effects;
    in property <string> dialog-risk;
    in property <int> dialog-level;
    callback dialog-answer(bool);

    // Settings page (9): update channel.
    in-out property <int> update-channel;
    in property <string> settings-message;
    callback settings-changed();


    title: "bitBybit " + root.version;
    preferred-width: 1440px;
    preferred-height: 860px;
    min-width: 1100px;
    min-height: 660px;
    background: Theme.workspace;
    default-font-size: Theme.font-body;
    default-font-family: "Poppins";
    icon: @image-url("assets/app-icon.png");
    init => { Palette.color-scheme = ColorScheme.dark; }

    // Header search (pages with lists), the chart's series, and what the header bell holds.
    property <string> query;
    property <bool> searchable: root.page == 1 || root.page == 3 || root.page == 7;
    property <int> chart-index;
    property <int> notifications: (root.broker-state == 2 ? 1 : 0) + (root.app-update-available ? 1 : 0) + (root.new-card-text != "" ? 1 : 0) + (root.op-state == 3 ? 1 : 0);
    property <string> page-title: root.page == 8 ? Tr.t("app.page.dashboard.title")
        : root.page == 6 ? Tr.t("app.page.case.title")
        : root.page == 0 ? Tr.t("app.page.network.title")
        : root.page == 1 ? Tr.t("app.page.devices.title")
        : root.page == 7 ? Tr.t("app.page.drivers.title")
        : root.page == 2 ? Tr.t("app.page.audio.title")
        : root.page == 5 ? Tr.t("app.page.displays.title")
        : root.page == 3 ? Tr.t("app.tab.changes")
        : root.page == 9 ? Tr.t("app.settings.title")
        : Tr.t("app.about.title");
    // Sharing: what the summary cards show.
    property <string> share-source-label: root.share-mode == 2 ? (root.share-repeater-source != "" ? root.share-repeater-source : "—") : root.share-upstream == 0 ? Tr.t("app.share.autoShort") : (root.share-labels.length > root.share-upstream ? root.share-labels[root.share-upstream] : "—");
    property <length> workspace-x: Theme.sidebar-width;
    property <length> workspace-w: root.width - Theme.sidebar-width;

    // A row matches the header search (case-insensitive substring; Slint has no `contains`).
    pure function matches(s: string) -> bool {
        return root.query == "" || s.to-lowercase().replace-all(root.query.to-lowercase(), "") != s.to-lowercase();
    }
    function go(p: int) {
        root.page = p;
        root.query = "";
    }

    // ── Sidebar
    Rectangle {
        x: 0;
        y: 0;
        width: Theme.sidebar-width;
        height: root.height;
        background: Theme.sidebar;
        VerticalLayout {
            padding-top: 26px;
            padding-bottom: 14px;
            spacing: 0px;
            // Identity: the logo, the name and the service link.
            VerticalLayout {
                spacing: 6px;
                padding-bottom: 20px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("assets/logo-mark.png");
                        width: 54px;
                        height: 54px;
                        image-fit: contain;
                        accessible-role: image;
                        accessible-label: "bitBybit";
                    }
                }
                Text { text: "bitBybit"; font-size: Theme.font-title; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    padding-left: 16px;
                    padding-right: 16px;
                    accessible-role: text;
                    accessible-label: root.broker-message;
                    StatusDot { tone: root.broker-state == 2 ? 2 : root.broker-state == 1 ? 4 : 0; }
                    Text {
                        text: root.broker-state == 2 ? Tr.t("app.service.error") : root.broker-state == 1 ? Tr.t("app.service.ok") : Tr.t("app.service.connecting");
                        font-size: Theme.font-caption;
                        color: Theme.text-secondary;
                        overflow: elide;
                    }
                }
            }
            NavItem { icon: @image-url("assets/icons/layout-dashboard.svg"); label: Tr.t("app.page.dashboard.title"); selected: root.page == 8; clicked => { root.go(8); } }
            Rectangle { height: 12px; }
            Rectangle { height: 1px; Rectangle { x: 24px; width: parent.width - 48px; background: Theme.divider; } }
            Rectangle { height: 8px; }
            NavGroup { text: Tr.t("app.nav.group.diagnostics"); }
            NavItem { icon: @image-url("assets/icons/stethoscope.svg"); label: Tr.t("app.nav.case"); selected: root.page == 6; clicked => { root.go(6); } }
            Rectangle { height: 8px; }
            NavGroup { text: Tr.t("app.nav.group.system"); }
            NavItem { icon: @image-url("assets/icons/network.svg"); label: Tr.t("app.tab.network"); selected: root.page == 0; clicked => { root.go(0); } }
            NavItem { icon: @image-url("assets/icons/cpu.svg"); label: Tr.t("app.page.devices.title"); selected: root.page == 1; clicked => { root.go(1); } }
            NavItem { icon: @image-url("assets/icons/hard-drive-download.svg"); label: Tr.t("app.page.drivers.title"); selected: root.page == 7; clicked => { root.go(7); root.refresh-drivers(); } }
            NavItem { icon: @image-url("assets/icons/volume-2.svg"); label: Tr.t("app.page.audio.title"); selected: root.page == 2; clicked => { root.go(2); } }
            NavItem { icon: @image-url("assets/icons/monitor.svg"); label: Tr.t("app.page.displays.title"); selected: root.page == 5; clicked => { root.go(5); } }
            Rectangle { height: 8px; }
            NavGroup { text: Tr.t("app.nav.group.activity"); }
            NavItem { icon: @image-url("assets/icons/history.svg"); label: Tr.t("app.page.changes.short"); selected: root.page == 3; clicked => { root.go(3); } }
            Rectangle { vertical-stretch: 1; }
            Rectangle { height: 1px; Rectangle { x: 24px; width: parent.width - 48px; background: Theme.divider; } }
            Rectangle { height: 8px; }
            NavItem { icon: @image-url("assets/icons/settings.svg"); label: Tr.t("app.settings.title"); selected: root.page == 9; clicked => { root.go(9); } }
            NavItem { icon: @image-url("assets/icons/info.svg"); label: Tr.t("app.about.title"); selected: root.page == 4; clicked => { root.go(4); } }
        }
    }

    // ── Workspace
    Rectangle {
        x: root.workspace-x;
        y: 0;
        width: root.workspace-w;
        height: root.height;
        HorizontalLayout {
            padding: Theme.pad;
            padding-left: max(Theme.pad, (root.workspace-w - Theme.content-max) / 2);
            padding-right: self.padding-left;
            VerticalLayout {
                spacing: Theme.gap;

                // Header: page title, search where the page has a list, notifications, settings.
                Panel {
                    height: Theme.header-height;
                    HorizontalLayout {
                        padding-left: 26px;
                        padding-right: 16px;
                        spacing: 12px;
                        Text { text: root.page-title; font-size: Theme.font-page; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if root.searchable: VerticalLayout {
                            alignment: center;
                            TextField {
                                width: 300px;
                                pill: true;
                                placeholder-text: Tr.t("app.search");
                                leading-icon: @image-url("assets/icons/search.svg");
                                text <=> root.query;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            bell := IconButton {
                                icon: @image-url("assets/icons/bell.svg");
                                tooltip: Tr.t("app.notifications");
                                badge: root.notifications;
                                clicked => { inbox.show(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton { icon: @image-url("assets/icons/settings.svg"); tooltip: Tr.t("app.settings.title"); clicked => { root.go(9); } }
                        }
                    }
                    inbox := PopupWindow {
                        x: parent.width - self.width - 16px;
                        y: parent.height + 6px;
                        width: 380px;
                        height: inbox-list.preferred-height;
                        Rectangle {
                            border-radius: Theme.radius-card;
                            background: Theme.panel;
                            border-width: 1px;
                            border-color: Theme.divider;
                            drop-shadow-color: #00000080;
                            drop-shadow-blur: 20px;
                            drop-shadow-offset-y: 8px;
                        }
                        inbox-list := VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Text { text: Tr.t("app.notifications"); font-size: Theme.font-title; font-weight: 700; color: Theme.text; }
                            if root.notifications == 0: Secondary { text: Tr.t("app.notifications.none"); }
                            if root.broker-state == 2: ActivityItem { icon: @image-url("assets/icons/circle-x.svg"); tint: Theme.red; title: Tr.t("app.service.error"); subtitle: root.broker-message; }
                            if root.op-state == 3: ActivityItem { icon: @image-url("assets/icons/triangle-alert.svg"); tint: Theme.amber; title: Tr.t("app.notifications.failed"); subtitle: root.op-message; }
                            if root.app-update-available: HorizontalLayout {
                                spacing: 10px;
                                ActivityItem { icon: @image-url("assets/icons/sparkles.svg"); tint: Theme.green; title: Tr.t("app.update.navAvailable"); subtitle: root.app-update-text; horizontal-stretch: 1; }
                                VerticalLayout { alignment: center; Button { text: Tr.t("app.notifications.open"); size: 1; clicked => { root.update-dialog-visible = true; } } }
                            }
                            if root.new-card-text != "": VerticalLayout {
                                spacing: 8px;
                                ActivityItem { icon: @image-url("assets/icons/wifi.svg"); tint: Theme.cyan; title: Tr.t("app.notifications.newCard"); subtitle: root.new-card-text; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    Button { text: Tr.t("app.op.dismiss"); kind: 3; size: 1; clicked => { root.new-card-text = ""; } }
                                    Button { text: Tr.t("app.share.shareThroughIt"); kind: 1; size: 1; clicked => { root.go(0); root.use-suggestion(); } }
                                }
                            }
                        }
                    }
                }

                // 8 · Resumo
                if root.page == 8: VerticalLayout {
                    spacing: Theme.gap;
                    vertical-stretch: 1;
                    KpiBand {
                        for kpi[i] in root.kpis: KpiCard {
                            horizontal-stretch: 1;
                            tone: i;
                            title: kpi.title;
                            value: kpi.value;
                            note: kpi.note;
                            action: Tr.t("app.kpi.detail");
                            activated => { root.go(kpi.page); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.gap;
                        vertical-stretch: 1;
                        Panel {
                            horizontal-stretch: 65;
                            preferred-width: 0px;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 14px;
                                PanelTitle {
                                    title: Tr.t("app.chart.title");
                                    if root.charts.length > 0: Select {
                                        pill: true;
                                        model: [root.charts[0].name, root.charts.length > 1 ? root.charts[1].name : root.charts[0].name];
                                        current-index <=> root.chart-index;
                                    }
                                }
                                if root.charts.length > root.chart-index && !root.charts[root.chart-index].empty: AreaChart {
                                    vertical-stretch: 1;
                                    line: root.charts[root.chart-index].line;
                                    area: root.charts[root.chart-index].area;
                                    x-labels: root.charts[root.chart-index].x-labels;
                                    y-labels: root.charts[root.chart-index].y-labels;
                                }
                                if root.charts.length <= root.chart-index || root.charts[root.chart-index].empty: EmptyState {
                                    vertical-stretch: 1;
                                    icon: @image-url("assets/icons/activity.svg");
                                    text: Tr.t("app.chart.empty");
                                }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Icon { y: (parent.height - self.height) / 2; source: @image-url("assets/icons/trending-up.svg"); tint: Theme.text-secondary; }
                                    Text { text: root.charts.length > root.chart-index ? root.charts[root.chart-index].summary : ""; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; }
                                    Button { text: Tr.t("app.kpi.detail"); size: 1; clicked => { root.go(3); } }
                                }
                            }
                        }
                        Panel {
                            horizontal-stretch: 35;
                            preferred-width: 0px;
                            min-width: 300px;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;
                                PanelTitle { title: Tr.t("app.activity.title"); }
                                if root.changes.length == 0: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/history.svg"); text: Tr.t("app.activity.empty"); }
                                if root.changes.length > 0: Scroller {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 16px;
                                        for change[i] in root.changes: ActivityItem {
                                            visible: i < 8;
                                            height: i < 8 ? self.preferred-height : 0px;
                                            icon: change.can-revert ? @image-url("assets/icons/history.svg") : @image-url("assets/icons/circle-check.svg");
                                            tint: change.can-revert ? Theme.cyan : Theme.text-secondary;
                                            title: change.kind;
                                            subtitle: change.when + "  ·  " + change.status;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 0 · Rede
                if root.page == 0: Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Theme.gap;
                        KpiBand {
                            KpiCard {
                                horizontal-stretch: 1;
                                tone: 0;
                                title: Tr.t("app.share.kpi.state");
                                value: root.share-session != "" ? Tr.t("app.share.kpi.on") : Tr.t("app.share.kpi.off");
                                note: root.share-session != "" ? root.share-clients + " " + Tr.t("app.share.clientsCount") : Tr.t("app.share.off");
                                action: Tr.t("app.share.tab.clients");
                                activated => { root.share-tab = 1; }
                            }
                            KpiCard {
                                horizontal-stretch: 1;
                                tone: 1;
                                title: Tr.t("app.share.flow.source");
                                value: root.share-source-label;
                                note: root.route-summary;
                                action: Tr.t("app.button.refresh");
                                activated => { root.refresh(); }
                            }
                            KpiCard {
                                horizontal-stretch: 1;
                                tone: 2;
                                title: Tr.t("app.network.interfaces");
                                value: root.interfaces.length;
                                note: Tr.t("app.network.visible");
                                action: Tr.t("app.kpi.detail");
                                activated => { root.share-tab = 0; }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            Panel {
                                horizontal-stretch: 65;
                                preferred-width: 0px;
                                height: share-box.preferred-height;
                                share-box := VerticalLayout {
                                    padding: 22px;
                                    spacing: 16px;
                                    HorizontalLayout {
                                        spacing: 14px;
                                        Rectangle {
                                            width: 42px;
                                            height: 42px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 10px;
                                            background: Theme.inset;
                                            Icon {
                                                width: 18px;
                                                height: 18px;
                                                tint: root.share-session != "" ? Theme.green : Theme.cyan;
                                                source: root.share-mode == 1 ? @image-url("assets/icons/router.svg") : root.share-mode == 2 ? @image-url("assets/icons/repeat-2.svg") : @image-url("assets/icons/wifi.svg");
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 3px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: root.share-mode == 1 ? Tr.t("app.share.mode.wired") : (root.share-name != "" ? root.share-name : Tr.t("app.share.mode.hotspot"));
                                                font-size: Theme.font-title;
                                                font-weight: 700;
                                                color: Theme.text;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                spacing: 6px;
                                                StatusDot { tone: root.share-session != "" ? 4 : 0; }
                                                Text {
                                                    text: root.share-session != "" ? Tr.t("app.share.sharingPrefix") + " " + root.share-sharing : Tr.t("app.share.off");
                                                    font-size: Theme.font-small;
                                                    color: root.share-session != "" ? Theme.green : Theme.text-secondary;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                icon: @image-url("assets/icons/power.svg");
                                                kind: root.share-session != "" ? 2 : 1;
                                                text: root.share-session != "" ? Tr.t("app.share.stopBig") : (root.share-mode == 1 ? Tr.t("app.share.startRouter") : root.share-mode == 2 ? Tr.t("app.share.startRepeater") : Tr.t("app.share.startHotspot"));
                                                clicked => { if (root.share-session != "") { root.stop-sharing(); } else { root.start-sharing(); } }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        Segmented {
                                            items: [{ label: Tr.t("app.share.tab.settings") }, { label: Tr.t("app.share.tab.clients"), badge: root.share-clients > 0 ? root.share-clients : "" }];
                                            selected <=> root.share-tab;
                                            segment-min: 120px;
                                        }
                                    }
                                    Divider { }

                                    // ── Definições
                                    if root.share-tab == 0: VerticalLayout {
                                        spacing: 16px;
                                        if root.share-suggestion != "" && root.share-session == "": StatusBanner {
                                            kind: 0;
                                            message: root.share-suggestion;
                                            Button { text: Tr.t("app.share.useSuggestion"); size: 1; clicked => { root.use-suggestion(); } }
                                        }
                                        Field {
                                            label: Tr.t("app.share.modeLabel");
                                            Segmented {
                                                enabled: root.share-session == "";
                                                segment-min: 150px;
                                                items: [
                                                    { label: Tr.t("app.share.mode.hotspot"), icon: @image-url("assets/icons/wifi.svg") },
                                                    { label: Tr.t("app.share.mode.wired"), icon: @image-url("assets/icons/router.svg") },
                                                    { label: Tr.t("app.share.mode.repeater"), icon: @image-url("assets/icons/repeat-2.svg") },
                                                ];
                                                selected <=> root.share-mode;
                                                changed(i) => { root.share-mode-changed(); }
                                            }
                                            Secondary {
                                                text: root.share-mode == 0 ? Tr.t("app.share.modeHint.hotspot") : root.share-mode == 1 ? Tr.t("app.share.modeHint.adapter") : Tr.t("app.share.modeHint.repeater");
                                            }
                                        }
                                        if root.share-mode != 1 && !root.share-has-wifi: StatusBanner { kind: 3; message: Tr.t("app.share.noWifi"); }
                                        if root.share-mode == 2 && root.share-has-wifi && root.share-repeater-source == "": StatusBanner { kind: 3; message: Tr.t("app.share.repeaterNoWifi"); }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            if root.share-mode != 2: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.internetToShare");
                                                Select {
                                                    enabled: root.share-session == "";
                                                    model: root.share-labels;
                                                    current-index <=> root.share-upstream;
                                                    selected => { root.share-upstream-changed(); }
                                                }
                                            }
                                            if root.share-mode == 2: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.internetToShare");
                                                TextField { enabled: false; text: root.share-source-label; }
                                            }
                                            if root.share-mode == 1: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.to");
                                                Select {
                                                    enabled: root.share-session == "";
                                                    model: root.share-target-labels;
                                                    current-index <=> root.share-downstream;
                                                }
                                            }
                                            if root.share-mode != 1: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.name");
                                                TextField { enabled: root.share-session == ""; text <=> root.share-name; }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 14px;
                                            if root.share-mode != 1: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.password");
                                                TextField {
                                                    enabled: root.share-session == "";
                                                    input-type: root.share-show-password ? InputType.text : InputType.password;
                                                    placeholder-text: Tr.t("app.share.passwordHint");
                                                    text <=> root.share-password;
                                                    IconButton {
                                                        width: 30px;
                                                        height: 30px;
                                                        y: 2px;
                                                        icon: root.share-show-password ? @image-url("assets/icons/eye-off.svg") : @image-url("assets/icons/eye.svg");
                                                        tooltip: root.share-show-password ? Tr.t("app.share.hide") : Tr.t("app.share.show");
                                                        clicked => { root.share-show-password = !root.share-show-password; }
                                                    }
                                                }
                                            }
                                            if root.share-mode == 1: Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.subnet");
                                                TextField { enabled: root.share-session == ""; placeholder-text: Tr.t("app.share.subnetAuto"); text <=> root.share-lan; }
                                            }
                                            Field {
                                                horizontal-stretch: 1;
                                                label: Tr.t("app.share.access");
                                                TextField { enabled: false; text: Tr.t("app.share.routedShort"); }
                                            }
                                        }
                                        Divider { }
                                        VerticalLayout {
                                            Text { text: Tr.t("app.share.protection"); font-size: Theme.font-title; font-weight: 700; color: Theme.text; }
                                            SettingRow {
                                                label: Tr.t("app.share.allowInternet");
                                                caption: Tr.t("app.share.allowInternetCaption");
                                                Toggle { checked <=> root.share-allow-internet; enabled: root.share-session == "" && root.share-upstream != 1; accessible-label: Tr.t("app.share.allowInternet"); }
                                            }
                                            Divider { }
                                            SettingRow {
                                                label: Tr.t("app.share.leakShort");
                                                caption: Tr.t("app.share.leakCaption");
                                                Badge {
                                                    text: !root.share-upstream-vpn ? Tr.t("app.share.leakState.needsVpn") : root.share-leak ? Tr.t("app.share.leakState.on") : Tr.t("app.share.leakState.off");
                                                    tone: !root.share-upstream-vpn ? 0 : root.share-leak ? 4 : 1;
                                                }
                                                Toggle { checked <=> root.share-leak; enabled: root.share-session == "" && root.share-upstream-vpn && root.share-allow-internet; accessible-label: Tr.t("app.share.leakShort"); }
                                            }
                                            if root.share-upstream-vpn && root.share-allow-internet && !root.share-leak: StatusBanner { kind: 3; message: Tr.t("app.share.leakOff"); }
                                        }
                                    }

                                    // ── Clientes
                                    if root.share-tab == 1: VerticalLayout {
                                        spacing: 12px;
                                        if root.share-session == "": EmptyState { icon: @image-url("assets/icons/smartphone.svg"); text: Tr.t("app.share.clientsOff"); }
                                        if root.share-session != "" && root.topo-nodes.length > 0: ShareDiagram {
                                            nodes: root.topo-nodes;
                                            canvas-height: root.topo-height;
                                            canvas-width: root.topo-width;
                                            move(i, dx, dy) => { root.topo-move(i, dx, dy); }
                                        }
                                        if root.share-session != "": Secondary { text: Tr.t("app.topo.hint"); }
                                        if root.share-session != "" && root.client-cards.length == 0: EmptyState { icon: @image-url("assets/icons/smartphone.svg"); text: Tr.t("app.client.none"); }
                                        for card in root.client-cards: ClientPanel {
                                            info: card;
                                            apply(mac, internet, local, gaming, fixed) => { root.client-apply(mac, internet, local, gaming, fixed); }
                                        }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 35;
                                preferred-width: 0px;
                                min-width: 300px;
                                height: max(ifaces.preferred-height, share-box.preferred-height);
                                ifaces := VerticalLayout {
                                    padding: 22px;
                                    spacing: 16px;
                                    alignment: start;
                                    PanelTitle { title: Tr.t("app.network.interfaces"); caption: root.interfaces.length + " " + Tr.t("app.network.visible"); }
                                    for row in root.interfaces: HorizontalLayout {
                                        spacing: 10px;
                                        ActivityItem {
                                            horizontal-stretch: 1;
                                            icon: row.vpn ? @image-url("assets/icons/shield-check.svg") : @image-url("assets/icons/network.svg");
                                            tint: row.up ? (row.vpn ? Theme.green : Theme.cyan) : Theme.text-muted;
                                            title: row.name;
                                            subtitle: row.addresses != "" ? row.addresses : row.kind;
                                        }
                                        VerticalLayout { alignment: center; Badge { text: row.status; tone: row.up ? 4 : 0; } }
                                    }
                                    if root.hidden-summary != "": Secondary { text: root.hidden-summary; color: Theme.text-muted; }
                                    Secondary { text: Tr.t("app.network.intro"); color: Theme.text-muted; }
                                }
                            }
                        }
                    }
                }

                // 6 · Caso Realtek / DisplayPort
                if root.page == 6: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        padding-bottom: 6px;
                        spacing: 10px;
                        PanelTitle {
                            title: Tr.t("app.case.panel");
                            caption: root.diagnosis-summary;
                            Button { icon: @image-url("assets/icons/activity.svg"); text: Tr.t("app.diagnosis.run"); kind: 1; loading: root.diagnosis-running; enabled: !root.diagnosis-running; clicked => { root.diagnose(); } }
                        }
                        if root.diagnosis-running: StatusBanner { kind: 4; message: Tr.t("app.diagnosis.running"); }
                        Divider { }
                        if root.findings.length == 0 && !root.diagnosis-running: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/stethoscope.svg"); text: Tr.t("app.diagnosis.notYet"); }
                        if root.findings.length > 0: Scroller {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for finding[fi] in root.findings: FindingItem {
                                    info: finding;
                                    last: fi == root.findings.length - 1;
                                    run(ai) => { root.run-finding-action(fi, ai); }
                                }
                            }
                        }
                    }
                }

                // 1 · Dispositivos
                if root.page == 1: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        padding-bottom: 6px;
                        spacing: 14px;
                        PanelTitle {
                            title: Tr.t("app.devices.panel");
                            caption: root.devices-summary;
                            Button { icon: @image-url("assets/icons/search.svg"); text: Tr.t("app.devices.rescan"); size: 1; clicked => { root.rescan(); } }
                            Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); size: 1; clicked => { root.refresh(); } }
                        }
                        TableHeader {
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                ColumnLabel { text: Tr.t("app.col.device"); horizontal-stretch: 1; }
                                ColumnLabel { text: Tr.t("app.col.class"); width: 120px; }
                                ColumnLabel { text: Tr.t("app.col.state"); width: 220px; }
                                ColumnLabel { text: Tr.t("app.col.actions"); width: 150px; horizontal-alignment: right; }
                            }
                        }
                        if root.devices.length == 0: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/cpu.svg"); text: root.devices-summary != "" ? root.devices-summary : Tr.t("app.devices.unavailable"); }
                        if root.devices.length > 0: Scroller {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for device[i] in root.devices: TableRow {
                                    property <bool> shown: root.matches(device.name + " " + device.class + " " + device.status + " " + device.driver);
                                    visible: self.shown;
                                    height: self.shown ? row.preferred-height : 0px;
                                    last: i == root.devices.length - 1;
                                    row := HorizontalLayout {
                                        padding: 14px;
                                        padding-top: 11px;
                                        padding-bottom: 11px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: device.name; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: device.driver; font-size: Theme.font-caption; color: Theme.text-muted; overflow: elide; }
                                        }
                                        Text { text: device.class; width: 120px; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                                        HorizontalLayout {
                                            width: 220px;
                                            spacing: 8px;
                                            StatusDot { tone: device.problem ? 2 : 4; }
                                            Text { text: device.status; font-size: Theme.font-small; color: device.problem ? Theme.red : Theme.text-secondary; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                                        }
                                        HorizontalLayout {
                                            width: 150px;
                                            spacing: 6px;
                                            alignment: end;
                                            if device.can-restart: VerticalLayout { alignment: center; Button { text: Tr.t("app.devices.action.restart"); size: 1; clicked => { root.device-action(device.id, "Restart"); } } }
                                            VerticalLayout {
                                                alignment: center;
                                                MenuButton {
                                                    tooltip: Tr.t("app.more");
                                                    entries: [
                                                        { label: Tr.t("app.devices.action.enable"), icon: @image-url("assets/icons/power.svg"), destructive: false, enabled: device.can-enable },
                                                        { label: Tr.t("app.devices.action.disable"), icon: @image-url("assets/icons/circle-x.svg"), destructive: false, enabled: device.can-disable },
                                                        { label: Tr.t("app.devices.action.drivers"), icon: @image-url("assets/icons/package.svg"), destructive: false, enabled: device.can-change-driver },
                                                        { label: Tr.t("app.devices.action.uninstall"), icon: @image-url("assets/icons/trash-2.svg"), destructive: true, enabled: device.can-uninstall },
                                                    ];
                                                    activated(a) => {
                                                        if (a == 0) { root.device-action(device.id, "Enable"); }
                                                        if (a == 1) { root.device-action(device.id, "Disable"); }
                                                        if (a == 2) { root.device-drivers(device.id, device.name); }
                                                        if (a == 3) { root.device-action(device.id, "Uninstall"); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 7 · Controladores
                if root.page == 7: Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Theme.gap;
                        Panel {
                            height: upd-box.preferred-height;
                            upd-box := VerticalLayout {
                                padding: 22px;
                                spacing: 14px;
                                PanelTitle {
                                    title: Tr.t("app.page.updates.title");
                                    caption: Tr.t("app.page.updates.intro");
                                    Button { icon: @image-url("assets/icons/search.svg"); text: Tr.t("app.page.updates.search"); size: 1; clicked => { root.search-updates(); } }
                                    if root.update-items.length > 0: Button { text: Tr.t("app.drivers.installSelected"); kind: 1; size: 1; clicked => { root.install-updates(); } }
                                }
                                if root.updates-searched && root.update-items.length == 0: StatusBanner { kind: 1; message: Tr.t("app.page.updates.noneToast"); }
                                if root.update-items.length > 0: VerticalLayout {
                                    TableHeader {
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            ColumnLabel { text: Tr.t("app.col.driver"); }
                                        }
                                    }
                                    for u[i] in root.update-items: TableRow {
                                        property <bool> shown: root.matches(u.title + " " + u.detail);
                                        visible: self.shown;
                                        height: self.shown ? upd-row.preferred-height : 0px;
                                        last: i == root.update-items.length - 1;
                                        upd-row := HorizontalLayout {
                                            padding: 12px;
                                            padding-left: 14px;
                                            Check { text: u.title + " — " + u.detail; toggled => { root.toggle-update(u.id, self.checked); } }
                                        }
                                    }
                                }
                            }
                        }
                        Panel {
                            height: cl-box.preferred-height;
                            cl-box := VerticalLayout {
                                padding: 22px;
                                spacing: 14px;
                                PanelTitle {
                                    title: Tr.t("app.page.cleanup.title");
                                    caption: Tr.t("app.cleanup.caption");
                                    if root.cleanup-items.length > 0: Button { icon: @image-url("assets/icons/trash-2.svg"); text: Tr.t("app.cleanup.apply"); kind: 2; size: 1; clicked => { root.apply-cleanup(); } }
                                }
                                if root.cleanup-items.length == 0: EmptyState { icon: @image-url("assets/icons/circle-check.svg"); text: Tr.t("app.cleanup.nothing"); }
                                if root.cleanup-items.length > 0: VerticalLayout {
                                    TableHeader {
                                        HorizontalLayout {
                                            padding-left: 42px;
                                            padding-right: 14px;
                                            spacing: 12px;
                                            ColumnLabel { text: Tr.t("app.col.item"); horizontal-stretch: 1; }
                                            ColumnLabel { text: Tr.t("app.col.impact"); width: 260px; }
                                            ColumnLabel { text: Tr.t("app.col.risk"); width: 150px; }
                                        }
                                    }
                                    for c[i] in root.cleanup-items: TableRow {
                                        property <bool> shown: root.matches(c.title + " " + c.detail);
                                        visible: self.shown;
                                        height: self.shown ? cl-row.preferred-height : 0px;
                                        last: i == root.cleanup-items.length - 1;
                                        cl-row := HorizontalLayout {
                                            padding: 12px;
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 12px;
                                            VerticalLayout { alignment: center; Check { accessible-label: c.title; toggled => { root.toggle-cleanup(c.id, c.device, self.checked); } } }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: c.title; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
                                                    if c.recommended: Badge { text: Tr.t("app.cleanup.recommended"); tone: 4; }
                                                }
                                                if c.detail != "": Text { text: c.detail; font-size: Theme.font-caption; color: Theme.text-muted; overflow: elide; }
                                            }
                                            Text { text: c.impact; width: 260px; font-size: Theme.font-small; color: Theme.amber; vertical-alignment: center; wrap: word-wrap; }
                                            VerticalLayout { width: 150px; alignment: center; Badge { text: c.risk; tone: 1; } }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            Panel {
                                horizontal-stretch: 65;
                                preferred-width: 0px;
                                height: st-box.preferred-height;
                                st-box := VerticalLayout {
                                    padding: 22px;
                                    spacing: 14px;
                                    alignment: start;
                                    PanelTitle { title: Tr.t("app.page.store.title"); caption: Tr.t("app.store.caption"); }
                                    TableHeader {
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 12px;
                                            ColumnLabel { text: Tr.t("app.col.package"); horizontal-stretch: 1; }
                                            ColumnLabel { text: Tr.t("app.col.usedBy"); width: 200px; }
                                            ColumnLabel { text: Tr.t("app.col.actions"); width: 110px; horizontal-alignment: right; }
                                        }
                                    }
                                    for p[i] in root.store-items: TableRow {
                                        property <bool> shown: root.matches(p.title + " " + p.detail + " " + p.used-by);
                                        visible: self.shown;
                                        height: self.shown ? st-row.preferred-height : 0px;
                                        last: i == root.store-items.length - 1;
                                        st-row := HorizontalLayout {
                                            padding: 12px;
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 12px;
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: p.title; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
                                                Text { text: p.detail; font-size: Theme.font-caption; color: Theme.text-muted; overflow: elide; }
                                            }
                                            Text { text: p.used-by != "" ? p.used-by : Tr.t("app.store.unused"); width: 200px; font-size: Theme.font-small; color: p.used-by != "" ? Theme.text-secondary : Theme.text-muted; vertical-alignment: center; wrap: word-wrap; }
                                            HorizontalLayout {
                                                width: 110px;
                                                alignment: end;
                                                if p.used-by == "": VerticalLayout { alignment: center; Button { text: Tr.t("app.store.remove"); kind: 2; size: 1; clicked => { root.remove-package(p.inf); } } }
                                            }
                                        }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 35;
                                preferred-width: 0px;
                                min-width: 300px;
                                height: max(bk-box.preferred-height, st-box.preferred-height);
                                bk-box := VerticalLayout {
                                    padding: 22px;
                                    spacing: 14px;
                                    alignment: start;
                                    PanelTitle { title: Tr.t("app.page.backups.title"); }
                                    if root.backups-text != "": ActivityItem { icon: @image-url("assets/icons/archive.svg"); tint: Theme.cyan; title: Tr.t("app.page.backups.title"); subtitle: root.backups-text; }
                                    if root.backups-text == "": EmptyState { icon: @image-url("assets/icons/archive.svg"); text: Tr.t("app.page.backups.empty"); }
                                }
                            }
                        }
                    }
                }

                // 2 · Áudio
                if root.page == 2: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        padding-bottom: 6px;
                        spacing: 14px;
                        PanelTitle {
                            title: Tr.t("app.audio.panel");
                            caption: root.audio-subtitle;
                            Button { text: Tr.t("app.audio.restartServices"); size: 1; clicked => { root.restart-audio-services(); } }
                            Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); size: 1; clicked => { root.refresh(); } }
                        }
                        if root.audio-profile != "": StatusBanner {
                            kind: 0;
                            message: root.audio-profile;
                            Button { text: Tr.t("app.audio.forgetProfile"); kind: 3; size: 1; clicked => { root.forget-profile(); } }
                        }
                        if root.audio-message != "": StatusBanner { kind: 0; message: root.audio-message; }
                        if root.audio.length == 0: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/volume-2.svg"); text: Tr.t("app.audio.none"); }
                        if root.audio.length > 0: Scroller {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 14px;
                                padding-bottom: 16px;
                                // Two columns: even endpoints left, odd right (Slint layouts have no wrapping grid).
                                HorizontalLayout {
                                    spacing: 14px;
                                    for col in [0, 1]: VerticalLayout {
                                        alignment: start;
                                        preferred-width: 0px;
                                        horizontal-stretch: 1;
                                        for endpoint[i] in root.audio: VerticalLayout {
                                            padding-bottom: Math.mod(i, 2) == col ? 14px : 0px;
                                            if Math.mod(i, 2) == col: AudioTile {
                                                info: endpoint;
                                                make-default(id) => { root.make-default(id); }
                                                set-volume(id, v) => { root.set-volume(id, v); }
                                                set-mute(id, m) => { root.set-mute(id, m); }
                                                prefer(id) => { root.prefer-endpoint(id); }
                                                force(id) => { root.force-output(id); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Icon { source: @image-url("assets/icons/info.svg"); tint: Theme.text-muted; width: 13px; height: 13px; y: 2px; }
                                    Text { text: Tr.t("app.action.undocumented"); font-size: Theme.font-caption; color: Theme.text-muted; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }

                // 5 · Ecrãs
                if root.page == 5: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        padding-bottom: 6px;
                        spacing: 14px;
                        PanelTitle {
                            title: Tr.t("app.displays.panel");
                            caption: root.displays-summary;
                            Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); size: 1; clicked => { root.refresh(); } }
                        }
                        TableHeader {
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                ColumnLabel { text: Tr.t("app.col.display"); horizontal-stretch: 1; }
                                ColumnLabel { text: Tr.t("app.col.connection"); width: 240px; }
                                ColumnLabel { text: Tr.t("app.col.mode"); width: 170px; }
                                ColumnLabel { text: Tr.t("app.col.edid"); width: 200px; }
                            }
                        }
                        if root.displays.length == 0: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/monitor.svg"); text: root.displays-failed ? root.displays-summary : Tr.t("app.displays.empty"); }
                        if root.displays.length > 0: Scroller {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for display[i] in root.displays: TableRow {
                                    height: d-row.preferred-height;
                                    last: i == root.displays.length - 1;
                                    d-row := HorizontalLayout {
                                        padding: 14px;
                                        spacing: 12px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: display.name; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
                                            if display.warning != "": Text { text: display.warning; font-size: Theme.font-caption; color: Theme.red; wrap: word-wrap; }
                                        }
                                        Text { text: display.connection; width: 240px; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; wrap: word-wrap; }
                                        VerticalLayout { width: 170px; alignment: center; Badge { text: display.mode; tone: 3; } }
                                        Text { text: display.edid; width: 200px; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3 · Alterações
                if root.page == 3: Panel {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 22px;
                        padding-bottom: 6px;
                        spacing: 14px;
                        PanelTitle {
                            title: Tr.t("app.changes.panel");
                            caption: Tr.t("app.changes.intro");
                            Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); size: 1; clicked => { root.refresh(); } }
                        }
                        if root.changes-message != "": StatusBanner { kind: 0; message: root.changes-message; }
                        TableHeader {
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                ColumnLabel { text: Tr.t("app.col.when"); width: 150px; }
                                ColumnLabel { text: Tr.t("app.col.change"); horizontal-stretch: 1; }
                                ColumnLabel { text: Tr.t("app.col.scope"); width: 110px; }
                                ColumnLabel { text: Tr.t("app.col.state"); width: 150px; }
                                ColumnLabel { text: Tr.t("app.col.actions"); width: 110px; horizontal-alignment: right; }
                            }
                        }
                        if root.changes.length == 0: EmptyState { vertical-stretch: 1; icon: @image-url("assets/icons/history.svg"); text: Tr.t("app.changes.empty"); }
                        if root.changes.length > 0: Scroller {
                            vertical-stretch: 1;
                            VerticalLayout {
                                for change[i] in root.changes: TableRow {
                                    property <bool> shown: root.matches(change.kind + " " + change.description + " " + change.status + " " + change.scope);
                                    visible: self.shown;
                                    height: self.shown ? c-row.preferred-height : 0px;
                                    last: i == root.changes.length - 1;
                                    c-row := HorizontalLayout {
                                        padding: 14px;
                                        padding-top: 11px;
                                        padding-bottom: 11px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            width: 150px;
                                            spacing: 8px;
                                            StatusDot { tone: change.can-revert ? 3 : 0; }
                                            Text { text: change.when; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; wrap: word-wrap; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: change.kind; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
                                            Text { text: change.description; font-size: Theme.font-caption; color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                        Text { text: change.scope; width: 110px; font-size: Theme.font-small; color: Theme.text-secondary; vertical-alignment: center; }
                                        VerticalLayout { width: 150px; alignment: center; Badge { text: change.status; tone: change.can-revert ? 4 : 0; } }
                                        HorizontalLayout {
                                            width: 110px;
                                            alignment: end;
                                            if change.can-revert: VerticalLayout { alignment: center; Button { icon: @image-url("assets/icons/undo-2.svg"); text: Tr.t("app.changes.revert"); size: 1; clicked => { root.revert(change.id); } } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 9 · Definições
                if root.page == 9: Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Theme.gap;
                        if root.settings-message != "": StatusBanner { kind: 2; message: root.settings-message; }
                        HorizontalLayout {
                            spacing: Theme.gap;
                            Panel {
                                horizontal-stretch: 65;
                                preferred-width: 0px;
                                height: up-box.preferred-height;
                                up-box := VerticalLayout {
                                    padding: 22px;
                                    padding-bottom: 12px;
                                    PanelTitle { title: Tr.t("app.settings.updates"); caption: Tr.t("app.update.securityHint"); }
                                    Rectangle { height: 8px; }
                                    SettingRow {
                                        label: Tr.t("app.update.channel");
                                        caption: Tr.t("app.update.channelHint");
                                        Segmented {
                                            items: [{ label: Tr.t("app.update.channel.testing") }, { label: Tr.t("app.update.channel.stable") }];
                                            segment-min: 170px;
                                            selected <=> root.update-channel;
                                            changed(i) => { root.settings-changed(); }
                                        }
                                    }
                                    Divider { }
                                    SettingRow {
                                        label: Tr.t("app.update.auto");
                                        Toggle { checked <=> root.update-auto; accessible-label: Tr.t("app.update.auto"); toggled => { root.settings-changed(); } }
                                    }
                                    Divider { }
                                    SettingRow {
                                        label: Tr.t("app.update.check");
                                        caption: root.app-update-text;
                                        Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.update.checkNow"); size: 1; loading: root.app-update-state == 1; clicked => { root.check-app-update(); } }
                                        if root.app-update-available: Button { text: Tr.t("app.update.install"); kind: 1; size: 1; clicked => { root.install-app-update(); } }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 35;
                                preferred-width: 0px;
                                min-width: 300px;
                                height: max(ac-box.preferred-height, up-box.preferred-height);
                                ac-box := VerticalLayout {
                                    padding: 22px;
                                    spacing: 14px;
                                    alignment: start;
                                    PanelTitle { title: Tr.t("app.settings.accessibility"); }
                                    ActivityItem { icon: @image-url("assets/icons/activity.svg"); title: Tr.t("app.settings.motionTitle"); subtitle: Theme.reduce-motion ? Tr.t("app.settings.motionOff") : Tr.t("app.settings.motionOn"); }
                                    Secondary { text: Tr.t("app.settings.motion"); color: Theme.text-muted; }
                                }
                            }
                        }
                    }
                }

                // 4 · Sobre
                if root.page == 4: Scroller {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: Theme.gap;
                        HorizontalLayout {
                            spacing: Theme.gap;
                            Panel {
                                horizontal-stretch: 65;
                                preferred-width: 0px;
                                height: about-box.preferred-height;
                                about-box := VerticalLayout {
                                    padding: 26px;
                                    spacing: 14px;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        Image { source: @image-url("assets/logo-mark.png"); width: 64px; height: 64px; image-fit: contain; accessible-role: image; accessible-label: "bitBybit"; }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "bitBybit"; font-size: Theme.font-page; font-weight: 700; color: Theme.text; }
                                            Secondary { text: root.about-version; }
                                        }
                                    }
                                    Body { text: Tr.t("app.settings.aboutText"); color: Theme.text-secondary; }
                                    Divider { }
                                    ActivityItem { icon: @image-url("assets/icons/shield-check.svg"); tint: Theme.green; title: Tr.t("app.about.updatesTitle"); subtitle: Tr.t("app.about.privacy"); }
                                    ActivityItem { icon: @image-url("assets/icons/archive.svg"); tint: Theme.cyan; title: Tr.t("app.about.logsTitle"); subtitle: root.logs-text; }
                                    if root.app-update-text != "": StatusBanner { kind: root.app-update-state == 3 ? 2 : root.app-update-state == 2 ? 1 : 0; message: root.app-update-text; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Button { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.update.check"); size: 1; loading: root.app-update-state == 1; clicked => { root.check-app-update(); } }
                                        Button { icon: @image-url("assets/icons/archive.svg"); text: Tr.t("app.export.button"); size: 1; clicked => { root.export-logs(); } }
                                        if root.app-update-available: Button { text: Tr.t("app.update.install"); kind: 1; size: 1; clicked => { root.install-app-update(); } }
                                    }
                                }
                            }
                            Panel {
                                horizontal-stretch: 35;
                                preferred-width: 0px;
                                min-width: 300px;
                                height: max(cr-box.preferred-height, about-box.preferred-height);
                                cr-box := VerticalLayout {
                                    padding: 22px;
                                    spacing: 14px;
                                    alignment: start;
                                    PanelTitle { title: Tr.t("app.settings.credits"); }
                                    Secondary { text: Tr.t("app.settings.creditsText"); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Operation feedback: a panel at the bottom right of the workspace.
    if root.op-state != 0 && !root.dialog-visible: Panel {
        width: min(root.workspace-w - 40px, 560px);
        height: toast.preferred-height;
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 8px;
        accessible-role: text;
        accessible-label: root.op-message;
        toast := HorizontalLayout {
            padding: 12px;
            padding-left: 16px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                if root.op-state == 1: Spinner { tint: Theme.cyan; size: 18px; }
                if root.op-state != 1: Icon {
                    width: 18px;
                    height: 18px;
                    source: root.op-state == 3 ? @image-url("assets/icons/circle-x.svg") : @image-url("assets/icons/circle-check.svg");
                    tint: root.op-state == 3 ? Theme.red : Theme.green;
                }
            }
            Text { text: root.op-message; wrap: word-wrap; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1; min-height: 30px; }
            if root.op-elevate: VerticalLayout { alignment: center; Button { text: Tr.t("app.op.elevate"); kind: 1; size: 1; clicked => { root.relaunch-elevated(); } } }
            if root.op-state != 1: VerticalLayout { alignment: center; IconButton { icon: @image-url("assets/icons/x.svg"); tooltip: Tr.t("app.op.dismiss"); clicked => { root.dismiss-op(); } } }
        }
    }

    // ── Choosing a driver for a device (opened from Dispositivos).
    if root.driver-device-id != "" && !root.dialog-visible: Modal {
        width: root.width;
        height: root.height;
        Panel {
            width: min(root.width - 64px, 660px);
            height: min(root.height - 64px, drv.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-color: Theme.divider;
            accessible-role: groupbox;
            accessible-label: Tr.t("app.drivers.chooser") + " " + root.driver-device-name;
            drv := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                PanelTitle {
                    title: Tr.t("app.drivers.chooser") + " " + root.driver-device-name;
                    IconButton { icon: @image-url("assets/icons/x.svg"); tooltip: Tr.t("app.op.dismiss"); clicked => { root.close-drivers(); } }
                }
                Scroller {
                    min-height: min(list.preferred-height, 120px);
                    preferred-height: list.preferred-height;
                    list := VerticalLayout {
                        for choice[i] in root.driver-choices: TableRow {
                            height: ch-row.preferred-height;
                            last: i == root.driver-choices.length - 1;
                            ch-row := HorizontalLayout {
                                padding: 12px;
                                spacing: 12px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text { text: choice.title; font-size: Theme.font-body; font-weight: 500; color: Theme.text; wrap: word-wrap; }
                                    Text { text: choice.detail; font-size: Theme.font-caption; color: Theme.text-muted; wrap: word-wrap; }
                                }
                                if choice.current: VerticalLayout { alignment: center; Badge { text: Tr.t("app.drivers.current"); tone: 4; } }
                                if !choice.current: VerticalLayout { alignment: center; Button { text: Tr.t("app.drivers.install"); kind: 1; size: 1; clicked => { root.install-driver(root.driver-device-id, choice.inf); } } }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { icon: @image-url("assets/icons/undo-2.svg"); text: Tr.t("app.drivers.rollback"); clicked => { root.rollback-driver(root.driver-device-id); } }
                    Button { text: Tr.t("app.op.dismiss"); kind: 3; clicked => { root.close-drivers(); } }
                }
            }
        }
    }

    // ── Confirmation dialog: summary, risk, warnings and effects, and the numbered steps. High risk gets a red edge
    // and a destructive confirm button so it never looks like a harmless operation.
    if root.dialog-visible: Modal {
        width: root.width;
        height: root.height;
        Panel {
            width: min(root.width - 64px, 620px);
            height: min(root.height - 64px, dialog-box.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-width: root.dialog-level >= 1 ? 1.5px : 1px;
            border-color: root.dialog-level >= 2 ? Theme.red : root.dialog-level == 1 ? Theme.amber : Theme.divider;
            accessible-role: groupbox;
            accessible-label: root.dialog-summary;
            dialog-box := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 10px;
                        background: Theme.inset;
                        Icon {
                            width: 18px;
                            height: 18px;
                            source: root.dialog-level >= 1 ? @image-url("assets/icons/triangle-alert.svg") : @image-url("assets/icons/shield-check.svg");
                            tint: root.dialog-level >= 2 ? Theme.red : root.dialog-level == 1 ? Theme.amber : Theme.green;
                        }
                    }
                    Text { text: root.dialog-summary; font-size: Theme.font-title + 1px; font-weight: 700; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: start;
                        Badge {
                            text: Tr.t("app.dialog.risk") + " " + root.dialog-risk;
                            tone: root.dialog-level >= 2 ? 2 : (root.dialog-level == 1 ? 1 : 4);
                        }
                    }
                }
                // Warnings and effects never scroll out of sight: they sit in a fixed box above the steps.
                if root.dialog-warnings.length + root.dialog-effects.length > 0: Rectangle {
                    border-radius: Theme.radius-control;
                    background: Theme.amber.with-alpha(0.12);
                    height: warn-box.preferred-height;
                    Rectangle { x: 0; width: 3px; border-radius: 1.5px; background: Theme.amber; }
                    warn-box := VerticalLayout {
                        padding: 12px;
                        padding-left: 16px;
                        spacing: 7px;
                        for warning in root.dialog-warnings: HorizontalLayout {
                            spacing: 9px;
                            Icon { source: @image-url("assets/icons/triangle-alert.svg"); tint: Theme.amber; y: 2px; }
                            Text { text: warning; wrap: word-wrap; font-size: Theme.font-body; font-weight: 600; color: Theme.text; }
                        }
                        for effect in root.dialog-effects: HorizontalLayout {
                            spacing: 9px;
                            Icon { source: @image-url("assets/icons/info.svg"); tint: Theme.amber; y: 2px; }
                            Text { text: effect; wrap: word-wrap; font-size: Theme.font-body; color: Theme.text; }
                        }
                    }
                }
                Scroller {
                    min-height: min(steps.preferred-height, 60px);
                    preferred-height: steps.preferred-height;
                    steps := VerticalLayout {
                        spacing: 8px;
                        for step[i] in root.dialog-steps: HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                border-radius: 11px;
                                background: Theme.inset;
                                Text { text: i + 1; font-size: Theme.font-caption; font-weight: 600; color: Theme.text-secondary; }
                            }
                            Body { text: step; vertical-alignment: center; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    padding-top: 4px;
                    Button { text: Tr.t("app.dialog.cancel"); clicked => { root.dialog-answer(false); } }
                    Button {
                        text: root.dialog-level >= 2 ? Tr.t("app.dialog.confirmRisky") : Tr.t("app.dialog.confirm");
                        kind: root.dialog-level >= 2 ? 2 : 1;
                        clicked => { root.dialog-answer(true); }
                    }
                }
            }
        }
    }

    // ── A new version: which, what changed, and a button to install. Nothing happens by itself: the download only
    // starts on request, and the signature and SHA-256 are checked before the swap.
    if root.update-dialog-visible && !root.dialog-visible: Modal {
        width: root.width;
        height: root.height;
        Panel {
            width: min(root.width - 64px, 580px);
            height: min(root.height - 64px, updlg-box.preferred-height);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-color: Theme.divider;
            accessible-role: groupbox;
            accessible-label: Tr.t("app.update.dialogTitle") + " " + root.update-version;
            updlg-box := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 10px;
                        background: Theme.inset;
                        Icon { width: 18px; height: 18px; source: @image-url("assets/icons/sparkles.svg"); tint: Theme.green; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: Tr.t("app.update.dialogTitle") + " " + root.update-version; font-size: Theme.font-title + 1px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                        Secondary { text: Tr.t("app.update.installed") + " " + root.version; }
                    }
                }
                Rectangle {
                    border-radius: Theme.radius-control;
                    background: Theme.inset;
                    min-height: 80px;
                    preferred-height: 200px;
                    Scroller {
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        height: parent.height - 16px;
                        Body { text: root.update-notes != "" ? root.update-notes : Tr.t("app.update.noNotes"); font-size: Theme.font-small; color: Theme.text-secondary; }
                    }
                }
                if root.app-update-state == 1 || root.app-update-state == 3: StatusBanner {
                    kind: root.app-update-state == 3 ? 2 : 4;
                    message: root.app-update-text;
                }
                Secondary { text: Tr.t("app.update.securityHint"); color: Theme.text-muted; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button { text: Tr.t("app.update.later"); enabled: root.app-update-state != 1; clicked => { root.dismiss-update(); } }
                    Button { text: Tr.t("app.update.install"); kind: 1; enabled: root.app-update-state == 2; loading: root.app-update-state == 1; clicked => { root.install-app-update(); } }
                }
            }
        }
    }
}
