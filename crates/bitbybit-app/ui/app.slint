// bitBybit main window (Liquid Glass design system: theme.slint + components.slint). Every visible text comes from
// the pt-PT catalog through Tr.t(key); data comes from the broker. No text is written here except catalog keys.

import { CheckBox, ComboBox, LineEdit, ScrollView, Palette, Slider, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Backdrop, Glass, Card, Icon, PillButton, NavItem, Badge, StatusBanner, PageHeader, SectionTitle, Secondary, Body, Segmented } from "components.slint";
import "assets/fonts/Inter-Regular.ttf";
import "assets/fonts/Inter-Medium.ttf";
import "assets/fonts/Inter-SemiBold.ttf";
import "assets/fonts/Inter-Bold.ttf";

export { Theme }

export global Tr {
    pure callback t(string) -> string;
}

export struct InterfaceRow {
    name: string,
    kind: string,
    status: string,
    addresses: string,
    vpn: bool,
    up: bool,
}

export struct DeviceRow {
    id: string,
    name: string,
    class: string,
    status: string,
    driver: string,
    problem: bool,
    can-restart: bool,
    can-enable: bool,
    can-disable: bool,
    can-uninstall: bool,
    can-change-driver: bool,
}

export struct DriverChoice {
    inf: string,
    title: string,
    detail: string,
    current: bool,
}

export struct AudioRow {
    id: string,
    name: string,
    flow: string,
    state: string,
    defaults: string,
    can-make-default: bool,
    volume: int,
    muted: bool,
    can-prefer: bool,
}

export struct DisplayRow {
    name: string,
    connection: string,
    mode: string,
    edid: string,
    warning: string,
}

export struct FindingRow {
    level: int,
    severity: string,
    title: string,
    detail: string,
    evidence: string,
    actions: string,
    buttons: [string],
}

export struct CleanupItem { id: string, device: bool, title: string, detail: string, impact: string, risk: string, recommended: bool }
export struct StoreItem { inf: string, title: string, detail: string, used-by: string }
export struct UpdateItem { id: string, title: string, detail: string }
export struct DashTile { title: string, value: string, state: int, page: int }
// One box of the sharing diagram. kind: 0 Internet carrier, 1 VPN, 2 where it is shared, 3 a device.
export struct TopoNode { id: string, kind: int, title: string, detail: string, parent: int, x: length, y: length }

export struct ChangeRow {
    id: string,
    when: string,
    kind: string,
    description: string,
    status: string,
    scope: string,
    can-revert: bool,
}

// Destructive actions (uninstall, delete) use the red capsule so they never look like harmless ones; every action
// still goes through the confirmation dialog that shows its impact and risk.
component DeviceCard inherits Card {
    in property <DeviceRow> info;
    callback action(string, string);
    callback drivers(string, string);
    tone: root.info.problem ? 2 : 0;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: Theme.space-m;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.space-s;
            Text { text: root.info.name; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; overflow: elide; }
            Rectangle { }
            Badge { text: root.info.class; tone: 0; }
        }
        Text { text: root.info.status; wrap: word-wrap; color: root.info.problem ? Theme.error : Theme.text; font-size: Theme.font-caption; }
        Secondary { text: root.info.driver; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            padding-top: 4px;
            if root.info.can-restart: PillButton { text: Tr.t("app.devices.action.restart"); clicked => { root.action(root.info.id, "Restart"); } }
            if root.info.can-enable: PillButton { text: Tr.t("app.devices.action.enable"); clicked => { root.action(root.info.id, "Enable"); } }
            if root.info.can-disable: PillButton { text: Tr.t("app.devices.action.disable"); clicked => { root.action(root.info.id, "Disable"); } }
            if root.info.can-change-driver: PillButton { text: Tr.t("app.devices.action.drivers"); clicked => { root.drivers(root.info.id, root.info.name); } }
            if root.info.can-uninstall: PillButton { text: Tr.t("app.devices.action.uninstall"); kind: 2; clicked => { root.action(root.info.id, "Uninstall"); } }
        }
    }
}

component AudioCard inherits Card {
    in property <AudioRow> info;
    callback make-default(string);
    callback set-volume(string, float);
    callback set-mute(string, bool);
    callback prefer(string);
    height: layout.preferred-height;
    layout := HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        VerticalLayout {
            spacing: 4px;
            Text { text: root.info.name; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; overflow: elide; }
            Secondary { text: root.info.flow + " · " + root.info.state; }
            if root.info.defaults != "": HorizontalLayout {
                alignment: start;
                Badge { text: root.info.defaults; tone: 3; }
            }
            if root.info.volume >= 0: HorizontalLayout {
                spacing: Theme.space-s;
                Slider {
                    min-width: 160px;
                    minimum: 0;
                    maximum: 100;
                    value: root.info.volume;
                    accessible-label: Tr.t("app.audio.volume");
                    released(v) => { root.set-volume(root.info.id, v); }
                }
                Switch {
                    text: Tr.t("app.audio.mute");
                    checked: root.info.muted;
                    toggled => { root.set-mute(root.info.id, self.checked); }
                }
            }
        }
        Rectangle { }
        if root.info.can-prefer: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            PillButton { text: Tr.t("app.audio.prefer"); clicked => { root.prefer(root.info.id); } }
        }
        if root.info.can-make-default: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            PillButton { text: Tr.t("app.audio.makeDefault"); kind: 1; clicked => { root.make-default(root.info.id); } }
        }
    }
}

component DisplayCard inherits Card {
    in property <DisplayRow> info;
    tone: root.info.warning != "" ? 2 : 0;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: Theme.space-m;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.space-s;
            Text { text: root.info.name; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; overflow: elide; }
            Rectangle { }
            Badge { text: root.info.mode; tone: 3; }
        }
        Secondary { text: root.info.connection; }
        Body { text: root.info.edid; font-size: Theme.font-caption; }
        if root.info.warning != "": Text { text: root.info.warning; color: Theme.error; font-size: Theme.font-caption; wrap: word-wrap; }
    }
}

component FindingCard inherits Card {
    in property <FindingRow> info;
    callback run(int);
    tone: root.info.level >= 2 ? 2 : (root.info.level == 1 ? 1 : 0);
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: Theme.space-m;
        spacing: 6px;
        HorizontalLayout {
            spacing: Theme.space-s;
            VerticalLayout {
                alignment: start;
                Badge { text: root.info.severity; tone: root.info.level >= 2 ? 2 : (root.info.level == 1 ? 1 : 0); }
            }
            Text { text: root.info.title; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; wrap: word-wrap; }
        }
        Body { text: root.info.detail; font-size: Theme.font-caption; }
        if root.info.evidence != "": Secondary { text: root.info.evidence; }
        if root.info.actions != "": Text { text: root.info.actions; font-size: Theme.font-caption; color: Theme.accent; wrap: word-wrap; }
        for label[i] in root.info.buttons: HorizontalLayout {
            alignment: start;
            PillButton { text: label; clicked => { root.run(i); } }
        }
    }
}

component ChangeCard inherits Card {
    in property <ChangeRow> info;
    callback revert(string);
    height: layout.preferred-height;
    layout := HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;
        VerticalLayout {
            spacing: 3px;
            Text { text: root.info.kind; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; }
            Body { text: root.info.description; font-size: Theme.font-caption; }
            Secondary { text: root.info.when + " · " + root.info.scope + " · " + root.info.status; }
        }
        Rectangle { }
        if root.info.can-revert: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            PillButton { text: Tr.t("app.changes.revert"); clicked => { root.revert(root.info.id); } }
        }
    }
}

component InterfaceCard inherits Card {
    in property <InterfaceRow> info;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: Theme.space-m;
        spacing: 4px;
        HorizontalLayout {
            spacing: Theme.space-s;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.info.up ? Theme.ok : Theme.text-secondary;
            }
            Text { text: root.info.name; font-size: Theme.font-emphasis; font-weight: 600; color: Theme.text; overflow: elide; vertical-alignment: center; }
            if root.info.vpn: VerticalLayout { alignment: center; Badge { text: "VPN"; tone: 3; } }
            Rectangle { }
            Text { text: root.info.status; color: root.info.up ? Theme.text : Theme.text-secondary; font-size: Theme.font-caption; vertical-alignment: center; }
        }
        Secondary { text: root.info.kind; }
        Body { text: root.info.addresses; font-size: Theme.font-caption; }
    }
}

// A dashboard tile: area icon, label, the live value and its state; opens the area's page.
component DashTileCard inherits Card {
    in property <DashTile> info;
    callback open(int);
    interactive: true;
    tone: root.info.state == 2 ? 2 : (root.info.state == 1 ? 1 : 0);
    height: max(84px, box.preferred-height);
    accessible-role: button;
    accessible-label: root.info.title + ": " + root.info.value;
    accessible-action-default => { root.open(root.info.page); }
    clicked => { root.open(root.info.page); }
    box := HorizontalLayout {
        padding: Theme.space-l;
        padding-left: Theme.space-l + 3px;
        spacing: Theme.space-m;
        Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: root.info.state == 2 ? Theme.error.with-alpha(0.14) : root.info.state == 1 ? Theme.warn.with-alpha(0.14) : Theme.accent-soft;
            Icon {
                width: 20px;
                height: 20px;
                tint: root.info.state == 2 ? Theme.error : root.info.state == 1 ? Theme.warn : Theme.accent;
                source: root.info.page == 1 ? @image-url("assets/icons/cpu.svg")
                    : root.info.page == 0 ? @image-url("assets/icons/network.svg")
                    : root.info.page == 2 ? @image-url("assets/icons/volume-2.svg")
                    : root.info.page == 5 ? @image-url("assets/icons/monitor.svg")
                    : root.info.page == 3 ? @image-url("assets/icons/history.svg")
                    : root.info.page == 6 ? @image-url("assets/icons/stethoscope.svg")
                    : @image-url("assets/icons/hard-drive-download.svg");
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            Text { text: root.info.title; font-size: Theme.font-caption; font-weight: 500; color: Theme.text-secondary; }
            Text { text: root.info.value; font-size: Theme.font-title + 1px; font-weight: 650; color: Theme.text; wrap: word-wrap; }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            source: @image-url("assets/icons/chevron-right.svg");
            tint: root.hovered ? Theme.accent : Theme.text-secondary;
        }
    }
}

// The live chain of the active share, as in a CI pipeline view: carrier → (VPN) → hotspot or card → devices.
// Boxes can be dragged; the links follow.
component ShareDiagram inherits Rectangle {
    in property <[TopoNode]> nodes;
    in property <length> canvas-height;
    in property <length> canvas-width;
    callback move(int, length, length);
    property <length> node-w: 180px;
    property <length> node-h: 64px;
    height: max(120px, root.canvas-height);
    border-radius: Theme.radius-m;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.edge;
    clip: true;
    accessible-role: groupbox;
    accessible-label: Tr.t("app.topo.title");
    // Wider than the page: a scroll bar (a mouse drag moves boxes, never the canvas).
    ScrollView {
        content-width: max(root.width - 2px, root.canvas-width);
        content-height: root.height - 2px;
    for n in root.nodes: Path {
        visible: n.parent >= 0;
        x: 0;
        y: 0;
        width: parent.content-width;
        height: root.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: n.kind == 3 ? Theme.text-secondary.with-alpha(0.45) : Theme.accent.with-alpha(0.7);
        stroke-width: 2px;
        fill: transparent;
        MoveTo {
            x: (root.nodes[n.parent].x + root.node-w) / 1px;
            y: (root.nodes[n.parent].y + root.node-h / 2) / 1px;
        }
        CubicTo {
            control-1-x: (root.nodes[n.parent].x + root.node-w + 24px) / 1px;
            control-1-y: (root.nodes[n.parent].y + root.node-h / 2) / 1px;
            control-2-x: (n.x - 24px) / 1px;
            control-2-y: (n.y + root.node-h / 2) / 1px;
            x: n.x / 1px;
            y: (n.y + root.node-h / 2) / 1px;
        }
    }
    for n[i] in root.nodes: Rectangle {
        x: n.x;
        y: n.y;
        width: root.node-w;
        height: root.node-h;
        border-radius: Theme.radius-m;
        background: drag.pressed ? Theme.surface-hover : Theme.glass-strong;
        border-width: 1px;
        border-color: drag.has-hover ? Theme.accent.with-alpha(0.6) : Theme.edge;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        accessible-role: text;
        accessible-label: n.title + ", " + n.detail;
        drag := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            moved => {
                if (self.pressed) {
                    root.move(i, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                border-radius: 9px;
                background: n.kind == 1 ? Theme.ok.with-alpha(0.16) : n.kind == 3 ? Theme.surface-hover : Theme.accent-soft;
                Icon {
                    width: 16px;
                    height: 16px;
                    tint: n.kind == 1 ? Theme.ok : n.kind == 3 ? Theme.text-secondary : Theme.accent;
                    source: n.kind == 0 ? @image-url("assets/icons/globe.svg")
                        : n.kind == 1 ? @image-url("assets/icons/shield-check.svg")
                        : n.kind == 2 ? @image-url("assets/icons/wifi.svg")
                        : @image-url("assets/icons/smartphone.svg");
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.ok;
                    }
                    Text { text: n.title; font-size: Theme.font-body; font-weight: 600; color: Theme.text; overflow: elide; }
                }
                Text { text: n.detail; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
            }
        }
    }
    }
}

// Empty / not-yet states: a quiet card instead of a bare line of text.
component EmptyState inherits Card {
    in property <string> text;
    height: 64px;
    Secondary { text: root.text; horizontal-alignment: center; vertical-alignment: center; width: parent.width - 32px; }
}

// A labelled form row (label column + control).
component FieldRow inherits HorizontalLayout {
    in property <string> label;
    spacing: Theme.space-s;
    Text { text: root.label; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; min-width: 140px; }
    @children
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <string> about-version;
    in property <string> logs-text;
    in property <int> broker-state;
    in property <string> broker-message;
    in property <string> route-summary;
    in property <string> hidden-summary;
    in property <[InterfaceRow]> interfaces;
    in property <[DeviceRow]> devices;
    callback device-action(string, string);
    callback device-drivers(string, string);
    callback rescan();
    in property <string> driver-device-id;
    in property <string> driver-device-name;
    in property <[DriverChoice]> driver-choices;
    callback install-driver(string, string);
    callback rollback-driver(string);
    callback close-drivers();
    in property <string> devices-summary;
    in property <[AudioRow]> audio;
    in property <string> audio-subtitle;
    in property <string> audio-message;
    in property <[DisplayRow]> displays;
    in property <string> displays-summary;
    in property <bool> displays-failed;
    in property <[FindingRow]> findings;
    in property <string> diagnosis-summary;
    in property <bool> diagnosis-running;
    callback diagnose();
    callback run-finding-action(int, int);
    in property <[ChangeRow]> changes;
    in property <string> changes-message;
    callback revert(string);
    callback make-default(string);
    callback set-volume(string, float);
    callback set-mute(string, bool);
    callback restart-audio-services();
    in property <[CleanupItem]> cleanup-items;
    in property <[StoreItem]> store-items;
    in property <[UpdateItem]> update-items;
    in property <bool> updates-searched;
    in property <string> backups-text;
    in property <[string]> share-labels;
    in-out property <int> share-upstream;
    in property <[string]> share-target-labels;
    in-out property <int> share-downstream;
    in-out property <string> share-lan;
    // 0 Wi-Fi hotspot (Windows Mobile Hotspot), 1 another network card.
    in-out property <int> share-mode;
    in property <bool> share-has-wifi: true;
    in-out property <string> share-name: "bitBybit";
    in-out property <string> share-password;
    in-out property <bool> share-leak;
    in property <bool> share-upstream-vpn;
    in property <string> share-session;
    in property <[TopoNode]> topo-nodes;
    in property <length> topo-height;
    in property <length> topo-width;
    callback topo-move(int, length, length);
    callback share-upstream-changed();
    callback start-sharing();
    callback stop-sharing();
    in property <string> app-update-text;
    in property <bool> app-update-available;
    // 0 idle/up to date, 1 working, 2 a version is available, 3 failed.
    in property <int> app-update-state;
    in-out property <bool> update-dialog-visible;
    in property <string> update-version;
    in property <string> update-notes;
    callback dismiss-update();
    in-out property <bool> update-auto: true;
    callback check-app-update();
    callback install-app-update();
    callback refresh-drivers();
    callback toggle-cleanup(string, bool, bool);
    callback toggle-update(string, bool);
    callback apply-cleanup();
    callback remove-package(string);
    callback search-updates();
    callback install-updates();
    callback prefer-endpoint(string);
    callback forget-profile();
    in property <string> audio-profile;
    in-out property <int> page: 8;
    in property <[DashTile]> tiles;
    callback refresh();
    // Operation feedback (0 none, 1 working, 2 done, 3 failed) and the confirmation dialog.
    in property <int> op-state;
    in property <string> op-message;
    in property <bool> op-elevate;
    callback dismiss-op();
    callback relaunch-elevated();
    in property <bool> dialog-visible;
    in property <string> dialog-summary;
    in property <[string]> dialog-steps;
    in property <[string]> dialog-warnings;
    in property <[string]> dialog-effects;
    in property <string> dialog-risk;
    in property <int> dialog-level;
    callback dialog-answer(bool);

    // Settings page (9): look (0 dark, 1 glass, 2 light, 3 custom), custom base and accent, update channel.
    in-out property <int> theme-index;
    in-out property <int> custom-base;
    in-out property <string> custom-accent;
    in-out property <int> update-channel;
    in property <string> settings-message;
    callback settings-changed();

    title: "bitBybit " + root.version;
    preferred-width: 1140px;
    preferred-height: 740px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg-bottom;
    default-font-size: Theme.font-body;
    default-font-family: "Inter";
    icon: @image-url("assets/app-icon.png");

    // Std widgets (combo boxes, switches, sliders) follow the look's light/dark scheme.
    property <bool> scheme-dark: Theme.dark;
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed scheme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }

    Backdrop { width: root.width; height: root.height; }

    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-m;

        // Navigation: the glass layer floats over the content.
        Glass {
            width: 232px;
            VerticalLayout {
                padding: Theme.space-m;
                spacing: 2px;
                // The brand: the original logo mark and wordmark, lit by a soft cyan glow.
                Rectangle {
                    height: 76px;
                    Rectangle {
                        x: 0px;
                        y: -4px;
                        width: 84px;
                        height: 84px;
                        background: @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.30 : 0.18) 0%, Theme.accent.with-alpha(0) 70%);
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-bottom: 8px;
                        spacing: 10px;
                        alignment: start;
                        Image {
                            source: @image-url("assets/logo-mark.png");
                            height: 52px;
                            width: 41px;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                            accessible-role: image;
                            accessible-label: "bitBybit";
                        }
                        // The wordmark as text: it follows the look (the logo's blue vanished on the glass backdrop).
                        HorizontalLayout {
                            y: (parent.height - self.height) / 2;
                            accessible-role: none;
                            Text { text: "bit"; font-size: 24px; font-weight: 800; letter-spacing: -0.6px; color: Theme.text; vertical-alignment: center; }
                            Text { text: "Bybit"; font-size: 24px; font-weight: 800; letter-spacing: -0.6px; color: Theme.accent; vertical-alignment: center; }
                        }
                    }
                }
                NavItem { icon: @image-url("assets/icons/layout-dashboard.svg"); label: Tr.t("app.page.dashboard.title"); selected: root.page == 8; clicked => { root.page = 8; } }
                NavItem { icon: @image-url("assets/icons/stethoscope.svg"); label: Tr.t("app.page.case.title"); selected: root.page == 6; clicked => { root.page = 6; } }
                NavItem { icon: @image-url("assets/icons/network.svg"); label: Tr.t("app.tab.network"); selected: root.page == 0; clicked => { root.page = 0; } }
                NavItem { icon: @image-url("assets/icons/cpu.svg"); label: Tr.t("app.page.devices.title"); selected: root.page == 1; clicked => { root.page = 1; } }
                NavItem { icon: @image-url("assets/icons/hard-drive-download.svg"); label: Tr.t("app.page.drivers.title"); selected: root.page == 7; clicked => { root.page = 7; root.refresh-drivers(); } }
                NavItem { icon: @image-url("assets/icons/volume-2.svg"); label: Tr.t("app.page.audio.title"); selected: root.page == 2; clicked => { root.page = 2; } }
                NavItem { icon: @image-url("assets/icons/monitor.svg"); label: Tr.t("app.page.displays.title"); selected: root.page == 5; clicked => { root.page = 5; } }
                NavItem { icon: @image-url("assets/icons/history.svg"); label: Tr.t("app.tab.changes"); selected: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { }
                // Always at hand, as in OrbisLink: looks for a new version now and says how it went.
                Rectangle { height: 1px; background: Theme.edge; }
                NavItem {
                    icon: @image-url("assets/icons/refresh-cw.svg");
                    label: root.app-update-state == 1 ? Tr.t("app.update.checkingShort") : (root.app-update-available ? Tr.t("app.update.navAvailable") : Tr.t("app.update.navCheck"));
                    selected: false;
                    clicked => { if (root.app-update-available) { root.update-dialog-visible = true; } else { root.check-app-update(); } }
                }
                if root.app-update-text != "": Text {
                    text: root.app-update-text;
                    wrap: word-wrap;
                    font-size: 11px;
                    color: root.app-update-state == 3 ? Theme.error : root.app-update-state == 2 ? Theme.ok : Theme.text-secondary;
                    x: 14px;
                    width: parent.width - 28px;
                }
                Rectangle { height: 1px; background: Theme.edge; }
                NavItem { icon: @image-url("assets/icons/settings.svg"); label: Tr.t("app.settings.title"); selected: root.page == 9; clicked => { root.page = 9; } }
                NavItem { icon: @image-url("assets/icons/info.svg"); label: Tr.t("app.about.title"); selected: root.page == 4; clicked => { root.page = 4; } }
            }
        }

        VerticalLayout {
            padding: Theme.space-s;
            padding-top: Theme.space-m;
            spacing: Theme.space-m;
            StatusBanner { kind: root.broker-state == 2 ? 2 : (root.broker-state == 1 ? 1 : 0); message: root.broker-message; }
            if root.op-state != 0: StatusBanner {
                kind: root.op-state == 3 ? 2 : (root.op-state == 2 ? 1 : 0);
                message: root.op-message;
                if root.op-elevate: PillButton { text: Tr.t("app.op.elevate"); kind: 1; clicked => { root.relaunch-elevated(); } }
                if root.op-state != 1: PillButton { text: Tr.t("app.op.dismiss"); kind: 3; clicked => { root.dismiss-op(); } }
            }

            // 8 · Resumo
            if root.page == 8: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.dashboard.title");
                    VerticalLayout { alignment: start; horizontal-stretch: 0; PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        // Two columns: even tiles left, odd tiles right (Slint layouts have no wrapping grid).
                        HorizontalLayout {
                            spacing: Theme.space-m;
                            for col in [0, 1]: VerticalLayout {
                                alignment: start;
                                // Equal columns: no preferred width, equal stretch.
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                for tile[i] in root.tiles: VerticalLayout {
                                    padding-bottom: Math.mod(i, 2) == col ? Theme.space-m : 0px;
                                    if Math.mod(i, 2) == col: DashTileCard { info: tile; open(p) => { root.page = p; } }
                                }
                            }
                        }
                    }
                }
            }

            // 0 · Rede
            if root.page == 0: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.network.title");
                    subtitle: Tr.t("app.network.intro");
                    VerticalLayout { alignment: start; horizontal-stretch: 0; PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        Body { text: root.route-summary; font-size: Theme.font-emphasis; }
                        Glass {
                            raised: false;
                            border-radius: Theme.radius-l;
                            height: share-box.preferred-height;
                            share-box := VerticalLayout {
                                padding: Theme.space-l;
                                spacing: Theme.space-s;
                                SectionTitle { text: Tr.t("app.share.title"); }
                                if root.share-session != "": VerticalLayout {
                                    spacing: Theme.space-s;
                                    HorizontalLayout {
                                        spacing: Theme.space-s;
                                        VerticalLayout { alignment: center; horizontal-stretch: 0; Badge { text: "●"; tone: 4; } }
                                        Body { text: Tr.t("app.share.active"); vertical-alignment: center; }
                                        PillButton { icon: @image-url("assets/icons/square-pen.svg"); text: Tr.t("app.topo.edit"); clicked => { root.stop-sharing(); } }
                                        PillButton { icon: @image-url("assets/icons/power.svg"); text: Tr.t("app.share.stop"); kind: 2; clicked => { root.stop-sharing(); } }
                                    }
                                    if root.topo-nodes.length > 0: ShareDiagram {
                                        nodes: root.topo-nodes;
                                        canvas-height: root.topo-height;
                                        canvas-width: root.topo-width;
                                        move(i, dx, dy) => { root.topo-move(i, dx, dy); }
                                    }
                                    if root.topo-nodes.length > 0: Secondary { text: Tr.t("app.topo.hint"); }
                                }
                                if root.share-session == "": VerticalLayout {
                                    spacing: Theme.space-s;
                                    HorizontalLayout {
                                        alignment: start;
                                        Segmented {
                                            items: [Tr.t("app.share.mode.hotspot"), Tr.t("app.share.mode.adapter")];
                                            selected <=> root.share-mode;
                                        }
                                    }
                                    Secondary { text: root.share-mode == 0 ? Tr.t("app.share.modeHint.hotspot") : Tr.t("app.share.modeHint.adapter"); }
                                    if root.share-mode == 0 && !root.share-has-wifi: StatusBanner { kind: 3; message: Tr.t("app.share.noWifi"); }
                                    FieldRow { label: Tr.t("app.share.from"); ComboBox { model: root.share-labels; current-index <=> root.share-upstream; selected => { root.share-upstream-changed(); } } }
                                    if root.share-mode == 0: FieldRow { label: Tr.t("app.share.name"); LineEdit { text <=> root.share-name; } }
                                    if root.share-mode == 0: FieldRow { label: Tr.t("app.share.password"); LineEdit { input-type: password; placeholder-text: Tr.t("app.share.passwordHint"); text <=> root.share-password; } }
                                    if root.share-mode == 1: FieldRow { label: Tr.t("app.share.to"); ComboBox { model: root.share-target-labels; current-index <=> root.share-downstream; } }
                                    if root.share-mode == 1: FieldRow { label: Tr.t("app.share.subnet"); LineEdit { placeholder-text: Tr.t("app.share.subnetAuto"); text <=> root.share-lan; } }
                                    Switch { text: Tr.t("app.share.leak"); checked <=> root.share-leak; enabled: root.share-upstream-vpn; }
                                    if root.share-upstream-vpn && !root.share-leak: StatusBanner { kind: 3; message: Tr.t("app.share.leakOff"); }
                                    HorizontalLayout {
                                        alignment: start;
                                        PillButton { text: Tr.t("app.share.start"); kind: 1; clicked => { root.start-sharing(); } }
                                    }
                                }
                            }
                        }
                        for row in root.interfaces: InterfaceCard { info: row; }
                        Secondary { text: root.hidden-summary; }
                    }
                }
            }

            // 1 · Dispositivos
            if root.page == 1: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.devices.title");
                    subtitle: root.devices-summary;
                    VerticalLayout {
                        alignment: start;
                        HorizontalLayout {
                            spacing: Theme.space-s;
                            PillButton { text: Tr.t("app.devices.rescan"); clicked => { root.rescan(); } }
                            PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                        }
                    }
                }
                if root.driver-device-id != "": Glass {
                    strong: true;
                    height: driver-panel.preferred-height;
                    driver-panel := VerticalLayout {
                        padding: Theme.space-l;
                        spacing: Theme.space-s;
                        HorizontalLayout {
                            spacing: Theme.space-s;
                            SectionTitle { text: Tr.t("app.drivers.chooser") + " " + root.driver-device-name; wrap: word-wrap; horizontal-stretch: 1; }
                            PillButton { text: Tr.t("app.drivers.rollback"); clicked => { root.rollback-driver(root.driver-device-id); } }
                            PillButton { text: Tr.t("app.op.dismiss"); kind: 3; clicked => { root.close-drivers(); } }
                        }
                        for choice in root.driver-choices: Card {
                            tone: choice.current ? 3 : 0;
                            height: choice-row.preferred-height;
                            choice-row := HorizontalLayout {
                                padding: Theme.space-s;
                                padding-left: Theme.space-m;
                                spacing: Theme.space-s;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: choice.title + (choice.current ? " · " + Tr.t("app.drivers.current") : ""); font-size: Theme.font-body; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                    Secondary { text: choice.detail; }
                                }
                                if !choice.current: VerticalLayout { alignment: center; horizontal-stretch: 0; PillButton { text: Tr.t("app.drivers.install"); kind: 1; clicked => { root.install-driver(root.driver-device-id, choice.inf); } } }
                            }
                        }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        if root.devices.length == 0: EmptyState { text: root.devices-summary != "" ? root.devices-summary : Tr.t("app.devices.unavailable"); }
                        for device in root.devices: DeviceCard {
                            info: device;
                            action(id, a) => { root.device-action(id, a); }
                            drivers(id, n) => { root.device-drivers(id, n); }
                        }
                    }
                }
            }

            // 7 · Controladores
            if root.page == 7: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader { title: Tr.t("app.page.drivers.title"); }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        SectionTitle { text: Tr.t("app.page.updates.title"); }
                        Secondary { text: Tr.t("app.page.updates.intro"); }
                        HorizontalLayout {
                            spacing: Theme.space-s;
                            alignment: start;
                            PillButton { text: Tr.t("app.page.updates.search"); clicked => { root.search-updates(); } }
                            if root.update-items.length > 0: PillButton { text: Tr.t("app.drivers.installSelected"); kind: 1; clicked => { root.install-updates(); } }
                        }
                        if root.updates-searched && root.update-items.length == 0: EmptyState { text: Tr.t("app.page.updates.noneToast"); }
                        for u in root.update-items: Card {
                            height: upd.preferred-height;
                            upd := HorizontalLayout {
                                padding: Theme.space-s;
                                padding-left: Theme.space-m;
                                CheckBox { text: u.title + " — " + u.detail; toggled => { root.toggle-update(u.id, self.checked); } }
                            }
                        }

                        SectionTitle { text: Tr.t("app.page.cleanup.title"); }
                        if root.cleanup-items.length == 0: EmptyState { text: Tr.t("app.cleanup.nothing"); }
                        for c in root.cleanup-items: Card {
                            tone: c.recommended ? 0 : 1;
                            height: cl.preferred-height;
                            cl := HorizontalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-s;
                                VerticalLayout { alignment: start; CheckBox { toggled => { root.toggle-cleanup(c.id, c.device, self.checked); } } }
                                VerticalLayout {
                                    spacing: 3px;
                                    HorizontalLayout {
                                        spacing: Theme.space-s;
                                        Text { text: c.title; font-size: Theme.font-body; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                        if c.recommended: VerticalLayout { alignment: start; Badge { text: Tr.t("app.cleanup.recommended"); tone: 4; } }
                                    }
                                    if c.detail != "": Secondary { text: c.detail; }
                                    Text { text: c.impact + " · " + c.risk; font-size: Theme.font-caption; color: Theme.warn; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.cleanup-items.length > 0: HorizontalLayout {
                            alignment: start;
                            PillButton { text: Tr.t("app.cleanup.apply"); kind: 2; clicked => { root.apply-cleanup(); } }
                        }

                        SectionTitle { text: Tr.t("app.page.store.title"); }
                        for p in root.store-items: Card {
                            height: st.preferred-height;
                            st := HorizontalLayout {
                                padding: Theme.space-m;
                                spacing: Theme.space-s;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: p.title; font-size: Theme.font-body; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                                    Secondary { text: p.detail; }
                                    if p.used-by != "": Body { text: p.used-by; font-size: Theme.font-caption; }
                                }
                                if p.used-by == "": VerticalLayout { alignment: center; horizontal-stretch: 0; PillButton { text: Tr.t("app.store.remove"); kind: 2; clicked => { root.remove-package(p.inf); } } }
                            }
                        }

                        SectionTitle { text: Tr.t("app.page.backups.title"); }
                        if root.backups-text != "": Secondary { text: root.backups-text; }
                        if root.backups-text == "": EmptyState { text: Tr.t("app.page.backups.empty"); }
                    }
                }
            }

            // 6 · Caso
            if root.page == 6: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.case.title");
                    subtitle: root.diagnosis-summary;
                    VerticalLayout { alignment: start; horizontal-stretch: 0; PillButton { text: Tr.t("app.diagnosis.run"); kind: 1; enabled: !root.diagnosis-running; clicked => { root.diagnose(); } } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        for finding[fi] in root.findings: FindingCard {
                            info: finding;
                            run(ai) => { root.run-finding-action(fi, ai); }
                        }
                    }
                }
            }

            // 2 · Áudio
            if root.page == 2: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.audio.title");
                    subtitle: root.audio-subtitle;
                    VerticalLayout {
                        alignment: start;
                        HorizontalLayout {
                            spacing: Theme.space-s;
                            PillButton { text: Tr.t("app.audio.restartServices"); clicked => { root.restart-audio-services(); } }
                            PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                        }
                    }
                }
                Secondary { text: Tr.t("app.action.undocumented"); }
                if root.audio-profile != "": StatusBanner {
                    kind: 0;
                    message: root.audio-profile;
                    PillButton { text: Tr.t("app.audio.forgetProfile"); kind: 3; clicked => { root.forget-profile(); } }
                }
                if root.audio-message != "": Body { text: root.audio-message; }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        for endpoint in root.audio: AudioCard {
                            info: endpoint;
                            make-default(id) => { root.make-default(id); }
                            set-volume(id, v) => { root.set-volume(id, v); }
                            set-mute(id, m) => { root.set-mute(id, m); }
                            prefer(id) => { root.prefer-endpoint(id); }
                        }
                    }
                }
            }

            // 5 · Ecrãs
            if root.page == 5: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.page.displays.title");
                    subtitle: root.displays-summary;
                    VerticalLayout { alignment: start; horizontal-stretch: 0; PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } } }
                }
                if root.displays.length == 0 && !root.displays-failed: EmptyState { text: Tr.t("app.displays.empty"); }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        for display in root.displays: DisplayCard { info: display; }
                    }
                }
            }

            // 3 · Alterações
            if root.page == 3: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader {
                    title: Tr.t("app.tab.changes");
                    subtitle: Tr.t("app.changes.intro");
                    VerticalLayout { alignment: start; horizontal-stretch: 0; PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } } }
                }
                if root.changes-message != "": Body { text: root.changes-message; }
                if root.changes.length == 0: EmptyState { text: Tr.t("app.changes.empty"); }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        for change in root.changes: ChangeCard {
                            info: change;
                            revert(id) => { root.revert(id); }
                        }
                    }
                }
            }

            // 9 · Definições
            if root.page == 9: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader { title: Tr.t("app.settings.title"); }
                ScrollView {
                    VerticalLayout {
                        spacing: Theme.space-m;
                        alignment: start;
                        Glass {
                            raised: false;
                            height: look.preferred-height;
                            look := VerticalLayout {
                                padding: Theme.space-l;
                                spacing: Theme.space-s;
                                SectionTitle { text: Tr.t("app.settings.look"); }
                                Secondary { text: Tr.t("app.settings.lookSaved"); }
                                HorizontalLayout {
                                    alignment: start;
                                    Segmented {
                                        items: [Tr.t("app.settings.theme.dark"), Tr.t("app.settings.theme.glass"), Tr.t("app.settings.theme.light"), Tr.t("app.settings.theme.custom")];
                                        selected <=> root.theme-index;
                                        changed(i) => { root.settings-changed(); }
                                    }
                                }
                                if root.theme-index == 3: VerticalLayout {
                                    spacing: Theme.space-s;
                                    padding-top: Theme.space-s;
                                    FieldRow {
                                        label: Tr.t("app.settings.customBase");
                                        Segmented {
                                            items: [Tr.t("app.settings.theme.dark"), Tr.t("app.settings.theme.glass"), Tr.t("app.settings.theme.light")];
                                            selected <=> root.custom-base;
                                            changed(i) => { root.settings-changed(); }
                                        }
                                        Rectangle { }
                                    }
                                    FieldRow {
                                        label: Tr.t("app.settings.colour.accent");
                                        LineEdit {
                                            max-width: 140px;
                                            placeholder-text: "#RRGGBB";
                                            text <=> root.custom-accent;
                                            accepted => { root.settings-changed(); }
                                        }
                                        for swatch in [{ hex: "#388AFF", c: #388AFF }, { hex: "#7A5CFF", c: #7A5CFF }, { hex: "#14B8A6", c: #14B8A6 }, { hex: "#F97316", c: #F97316 }, { hex: "#EC4899", c: #EC4899 }]: Rectangle {
                                            width: 26px;
                                            height: 26px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 13px;
                                            background: swatch.c;
                                            border-width: root.custom-accent == swatch.hex ? 2px : 1px;
                                            border-color: root.custom-accent == swatch.hex ? Theme.text : Theme.edge;
                                            accessible-role: button;
                                            accessible-label: Tr.t("app.settings.suggestions") + " " + swatch.hex;
                                            accessible-action-default => { root.custom-accent = swatch.hex; root.settings-changed(); }
                                            TouchArea { mouse-cursor: pointer; clicked => { root.custom-accent = swatch.hex; root.settings-changed(); } }
                                        }
                                        Rectangle { }
                                    }
                                    Secondary { text: Tr.t("app.settings.accentHint"); }
                                }
                                Secondary { text: Tr.t("app.settings.motion"); }
                            }
                        }
                        Glass {
                            raised: false;
                            height: upd-box.preferred-height;
                            upd-box := VerticalLayout {
                                padding: Theme.space-l;
                                spacing: Theme.space-s;
                                SectionTitle { text: Tr.t("app.settings.updates"); }
                                FieldRow {
                                    label: Tr.t("app.update.channel");
                                    Segmented {
                                        items: [Tr.t("app.update.channel.testing"), Tr.t("app.update.channel.stable")];
                                        selected <=> root.update-channel;
                                        changed(i) => { root.settings-changed(); }
                                    }
                                    Rectangle { }
                                }
                                Secondary { text: Tr.t("app.update.channelHint"); }
                                Switch { text: Tr.t("app.update.auto"); checked <=> root.update-auto; toggled => { root.settings-changed(); } }
                                Secondary { text: Tr.t("app.update.securityHint"); }
                                HorizontalLayout {
                                    spacing: Theme.space-s;
                                    alignment: start;
                                    padding-top: 4px;
                                    PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.update.check"); clicked => { root.check-app-update(); } }
                                    if root.app-update-available: PillButton { text: Tr.t("app.update.install"); kind: 1; clicked => { root.install-app-update(); } }
                                }
                                if root.app-update-text != "": Body { text: root.app-update-text; }
                            }
                        }
                        if root.settings-message != "": StatusBanner { kind: 2; message: root.settings-message; }
                    }
                }
            }

            // 4 · Sobre
            if root.page == 4: VerticalLayout {
                spacing: Theme.space-m;
                PageHeader { title: Tr.t("app.about.title"); }
                Glass {
                    raised: false;
                    height: about-box.preferred-height;
                    about-box := VerticalLayout {
                        padding: Theme.space-l;
                        spacing: Theme.space-s;
                        Body { text: root.about-version; font-size: Theme.font-emphasis; font-weight: 600; }
                        Secondary { text: Tr.t("app.settings.aboutText"); }
                        Secondary { text: Tr.t("app.about.privacy"); }
                        Secondary { text: root.logs-text; }
                        HorizontalLayout {
                            spacing: Theme.space-s;
                            alignment: start;
                            padding-top: 4px;
                            PillButton { icon: @image-url("assets/icons/refresh-cw.svg"); text: Tr.t("app.update.check"); clicked => { root.check-app-update(); } }
                            if root.app-update-available: PillButton { text: Tr.t("app.update.install"); kind: 1; clicked => { root.install-app-update(); } }
                        }
                        if root.app-update-text != "": Body { text: root.app-update-text; }
                    }
                }
                Rectangle { }
            }
        }
    }

    // Confirmation dialog: the plan's summary, risk, steps, effects and warnings are always shown; a high-risk plan
    // gets a red edge and a destructive confirm button so it never looks like a harmless operation.
    if root.dialog-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea { }
        Glass {
            strong: true;
            width: min(root.width - 48px, 640px);
            height: min(root.height - 48px, dialog-box.preferred-height);
            border-radius: Theme.radius-xl;
            border-color: root.dialog-level >= 2 ? Theme.error.with-alpha(0.7) : (root.dialog-level == 1 ? Theme.warn.with-alpha(0.55) : Theme.edge);
            accessible-role: groupbox;
            accessible-label: root.dialog-summary;
            dialog-box := VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-s;
                Secondary { text: Tr.t("app.dialog.title"); }
                Text { text: root.dialog-summary; font-size: 18px; font-weight: 650; color: Theme.text; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: start;
                    Badge {
                        text: Tr.t("app.dialog.risk") + " " + root.dialog-risk;
                        tone: root.dialog-level >= 2 ? 2 : (root.dialog-level == 1 ? 1 : 4);
                    }
                }
                // Warnings and effects never scroll out of sight: they sit in a fixed box above the steps.
                if root.dialog-warnings.length + root.dialog-effects.length > 0: Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.warn.with-alpha(0.10);
                    border-width: 1px;
                    border-color: Theme.warn.with-alpha(0.35);
                    height: warn-box.preferred-height;
                    warn-box := VerticalLayout {
                        padding: Theme.space-m;
                        spacing: 6px;
                        for warning in root.dialog-warnings: HorizontalLayout {
                            spacing: Theme.space-s;
                            Icon { source: @image-url("assets/icons/triangle-alert.svg"); tint: Theme.warn; y: 1px; }
                            Text { text: warning; wrap: word-wrap; font-size: Theme.font-body; font-weight: 600; color: Theme.text; }
                        }
                        for effect in root.dialog-effects: HorizontalLayout {
                            spacing: Theme.space-s;
                            Icon { source: @image-url("assets/icons/info.svg"); tint: Theme.warn; y: 1px; }
                            Text { text: effect; wrap: word-wrap; font-size: Theme.font-body; color: Theme.text; }
                        }
                    }
                }
                ScrollView {
                    min-height: min(steps.preferred-height, 60px);
                    preferred-height: steps.preferred-height;
                    steps := VerticalLayout {
                        spacing: 6px;
                        alignment: start;
                        for step[i] in root.dialog-steps: Body { text: (i + 1) + ". " + step; }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: end;
                    padding-top: Theme.space-s;
                    PillButton { text: Tr.t("app.dialog.cancel"); clicked => { root.dialog-answer(false); } }
                    PillButton {
                        text: root.dialog-level >= 2 ? Tr.t("app.dialog.confirmRisky") : Tr.t("app.dialog.confirm");
                        kind: root.dialog-level >= 2 ? 2 : 1;
                        clicked => { root.dialog-answer(true); }
                    }
                }
            }
        }
    }

    // A new version: which, what changed, and a button to install. Nothing happens by itself: the download only
    // starts on request, and the signature and SHA-256 are checked before the swap.
    if root.update-dialog-visible && !root.dialog-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.scrim;
        TouchArea { }
        Glass {
            strong: true;
            width: min(root.width - 48px, 620px);
            height: min(root.height - 48px, updlg-box.preferred-height);
            border-radius: Theme.radius-xl;
            accessible-role: groupbox;
            accessible-label: Tr.t("app.update.dialogTitle") + " " + root.update-version;
            updlg-box := VerticalLayout {
                padding: Theme.space-xl;
                spacing: Theme.space-m;
                HorizontalLayout {
                    spacing: Theme.space-s;
                    Text { text: Tr.t("app.update.dialogTitle") + " " + root.update-version; font-size: 18px; font-weight: 650; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                    Secondary { text: Tr.t("app.update.youHave") + " " + root.version; vertical-alignment: center; horizontal-stretch: 0; wrap: no-wrap; }
                }
                Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.edge;
                    min-height: 80px;
                    preferred-height: 200px;
                    ScrollView {
                        x: Theme.space-m;
                        y: Theme.space-s;
                        width: parent.width - 2 * Theme.space-m;
                        height: parent.height - 2 * Theme.space-s;
                        VerticalLayout {
                            alignment: start;
                            Body { text: root.update-notes != "" ? root.update-notes : Tr.t("app.update.noNotes"); font-size: Theme.font-caption; }
                        }
                    }
                }
                if root.app-update-state == 1 || root.app-update-state == 3: StatusBanner {
                    kind: root.app-update-state == 3 ? 2 : 0;
                    message: root.app-update-text;
                }
                Secondary { text: Tr.t("app.update.securityHint"); }
                HorizontalLayout {
                    spacing: Theme.space-s;
                    alignment: end;
                    PillButton { text: Tr.t("app.update.later"); enabled: root.app-update-state != 1; clicked => { root.dismiss-update(); } }
                    PillButton { text: Tr.t("app.update.install"); kind: 1; enabled: root.app-update-state == 2; clicked => { root.install-app-update(); } }
                }
            }
        }
    }
}
