// bitBybit main window. Every visible text comes from the pt-PT catalog through Tr.t(key); data comes from the
// broker. No text is written here except catalog keys.

import { Button, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export global Tr {
    pure callback t(string) -> string;
}

export struct InterfaceRow {
    name: string,
    kind: string,
    status: string,
    addresses: string,
    vpn: bool,
    up: bool,
}

export struct DeviceRow {
    name: string,
    class: string,
    status: string,
    driver: string,
    problem: bool,
}

component DeviceCard inherits Rectangle {
    in property <DeviceRow> info;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.info.problem ? #c42b1c : Palette.border;
    background: Palette.control-background;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.info.name; font-size: 14px; font-weight: 600; overflow: elide; }
            Rectangle { }
            Text { text: root.info.class; color: #707070; font-size: 12px; }
        }
        Text { text: root.info.status; wrap: word-wrap; color: root.info.problem ? #c42b1c : Palette.foreground; font-size: 12px; }
        Text { text: root.info.driver; color: #707070; font-size: 12px; wrap: word-wrap; }
    }
}

export struct AudioRow {
    id: string,
    name: string,
    flow: string,
    state: string,
    defaults: string,
    can-make-default: bool,
}

component AudioCard inherits Rectangle {
    in property <AudioRow> info;
    callback make-default(string);
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
    height: layout.preferred-height;
    layout := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            Text { text: root.info.name; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.info.flow + " · " + root.info.state; color: #707070; font-size: 12px; }
            if root.info.defaults != "": Text { text: root.info.defaults; color: Palette.accent-background; font-size: 12px; }
        }
        Rectangle { }
        if root.info.can-make-default: VerticalLayout {
            alignment: center;
            Button { text: Tr.t("app.audio.makeDefault"); clicked => { root.make-default(root.info.id); } }
        }
    }
}

export struct ChangeRow {
    id: string,
    when: string,
    kind: string,
    description: string,
    status: string,
    scope: string,
    can-revert: bool,
}

component ChangeCard inherits Rectangle {
    in property <ChangeRow> info;
    callback revert(string);
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
    height: layout.preferred-height;
    layout := HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        VerticalLayout {
            spacing: 2px;
            Text { text: root.info.kind; font-size: 14px; font-weight: 600; }
            Text { text: root.info.description; wrap: word-wrap; font-size: 12px; }
            Text { text: root.info.when + " · " + root.info.scope + " · " + root.info.status; color: #707070; font-size: 12px; }
        }
        Rectangle { }
        if root.info.can-revert: VerticalLayout {
            alignment: center;
            Button { text: Tr.t("app.changes.revert"); clicked => { root.revert(root.info.id); } }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Palette.accent-background : (touch.has-hover ? Palette.alternate-background : transparent);
    accessible-role: tab;
    accessible-label: root.label;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        text: root.label;
        vertical-alignment: center;
        color: root.selected ? Palette.accent-foreground : Palette.foreground;
        font-size: 14px;
    }
}

component Banner inherits Rectangle {
    // 0 = working, 1 = ok, 2 = problem
    in property <int> kind;
    in property <string> message;
    height: msg.preferred-height + 16px;
    border-radius: 6px;
    background: root.kind == 2 ? #fde7e9 : (root.kind == 1 ? #dff6dd : Palette.alternate-background);
    msg := Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.message;
        wrap: word-wrap;
        vertical-alignment: center;
        // Dark text on the light status colours keeps contrast in both themes.
        color: root.kind == 0 ? Palette.foreground : #1b1b1b;
    }
}

component InterfaceCard inherits Rectangle {
    in property <InterfaceRow> info;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.control-background;
    height: layout.preferred-height;
    layout := VerticalLayout {
        padding: 12px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: root.info.name; font-size: 15px; font-weight: 600; overflow: elide; }
            if root.info.vpn: Rectangle {
                width: vpn-label.preferred-width + 12px;
                border-radius: 4px;
                background: Palette.accent-background;
                vpn-label := Text { text: "VPN"; color: Palette.accent-foreground; font-size: 11px; vertical-alignment: center; horizontal-alignment: center; }
            }
            Rectangle { }
            Text { text: root.info.status; color: root.info.up ? Palette.foreground : #8a8a8a; }
        }
        Text { text: root.info.kind; color: #707070; font-size: 12px; }
        Text { text: root.info.addresses; font-size: 12px; wrap: word-wrap; }
    }
}

export component AppWindow inherits Window {
    in property <string> version;
    in property <string> about-version;
    in property <int> broker-state;
    in property <string> broker-message;
    in property <string> route-summary;
    in property <string> hidden-summary;
    in property <[InterfaceRow]> interfaces;
    in property <[DeviceRow]> devices;
    in property <string> devices-summary;
    in property <[AudioRow]> audio;
    in property <string> audio-subtitle;
    in property <string> audio-message;
    in property <[ChangeRow]> changes;
    in property <string> changes-message;
    callback revert(string);
    callback make-default(string);
    in-out property <int> page: 0;
    callback refresh();

    title: "bitBybit " + root.version;
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 420px;
    background: Palette.background;

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text { text: "bitBybit"; font-size: 20px; font-weight: 700; height: 40px; vertical-alignment: center; }
                NavItem { label: Tr.t("app.tab.network"); selected: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: Tr.t("app.page.devices.title"); selected: root.page == 1; clicked => { root.page = 1; } }
                NavItem { label: Tr.t("app.page.audio.title"); selected: root.page == 2; clicked => { root.page = 2; } }
                NavItem { label: Tr.t("app.tab.changes"); selected: root.page == 3; clicked => { root.page = 3; } }
                NavItem { label: Tr.t("app.about.title"); selected: root.page == 4; clicked => { root.page = 4; } }
                Rectangle { }
            }
        }
        VerticalBox {
            padding: 20px;
            spacing: 12px;
            Banner { kind: root.broker-state; message: root.broker-message; }
            if root.page == 0: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        Text { text: Tr.t("app.page.network.title"); font-size: 22px; font-weight: 600; }
                        Text { text: Tr.t("app.network.intro"); wrap: word-wrap; color: #707070; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Button { text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                    }
                }
                Text { text: root.route-summary; wrap: word-wrap; font-size: 14px; }
                ScrollView {
                    VerticalLayout {
                        spacing: 8px;
                        for row in root.interfaces: InterfaceCard { info: row; }
                        Text { text: root.hidden-summary; color: #707070; font-size: 12px; }
                    }
                }
            }
            if root.page == 1: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        Text { text: Tr.t("app.page.devices.title"); font-size: 22px; font-weight: 600; }
                        Text { text: root.devices-summary; color: #707070; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Button { text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for device in root.devices: DeviceCard { info: device; }
                    }
                }
            }
            if root.page == 2: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        Text { text: Tr.t("app.page.audio.title"); font-size: 22px; font-weight: 600; }
                        Text { text: root.audio-subtitle; color: #707070; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Button { text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                    }
                }
                Text { text: Tr.t("app.action.undocumented"); wrap: word-wrap; color: #707070; font-size: 12px; }
                if root.audio-message != "": Text { text: root.audio-message; wrap: word-wrap; font-size: 13px; }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for endpoint in root.audio: AudioCard {
                            info: endpoint;
                            make-default(id) => { root.make-default(id); }
                        }
                    }
                }
            }
            if root.page == 3: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        Text { text: Tr.t("app.tab.changes"); font-size: 22px; font-weight: 600; }
                        Text { text: Tr.t("app.changes.intro"); color: #707070; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: start;
                        Button { text: Tr.t("app.button.refresh"); clicked => { root.refresh(); } }
                    }
                }
                if root.changes-message != "": Text { text: root.changes-message; wrap: word-wrap; font-size: 13px; }
                if root.changes.length == 0: Text { text: Tr.t("app.changes.empty"); color: #707070; }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for change in root.changes: ChangeCard {
                            info: change;
                            revert(id) => { root.revert(id); }
                        }
                    }
                }
            }
            if root.page == 4: VerticalLayout {
                spacing: 8px;
                Text { text: Tr.t("app.about.title"); font-size: 22px; font-weight: 600; }
                Text { text: root.about-version; wrap: word-wrap; }
                Text { text: Tr.t("app.about.privacy"); wrap: word-wrap; }
                Rectangle { }
            }
        }
    }
}
