// Layout and display pieces of the bitBybit design system. Status is never colour-only: every state carries text
// (and, for banners, an icon).

import { Theme } from "theme.slint";
import { GlassEngine, GlassFrame } from "glass.slint";
import { Icon, Spinner } from "controls.slint";
import { ScrollView } from "std-widgets.slint";

// Vertical scrolling at the visible width: content never widens the pane, wrapped text wraps.
export component Scroller inherits ScrollView {
    VerticalLayout {
        width: root.visible-width;
        alignment: start;
        @children
    }
}

export component SectionTitle inherits Text {
    font-size: Theme.font-title;
    font-weight: 650;
    color: Theme.text;
}

// Label of a group of rows or fields (sidebar groups, form groups) — only where it names what follows.
export component Eyebrow inherits Text {
    font-size: Theme.font-small;
    font-weight: 600;
    color: Theme.text-tertiary;
}

export component Secondary inherits Text {
    font-size: Theme.font-small;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

export component Body inherits Text {
    font-size: Theme.font-body;
    color: Theme.text;
    wrap: word-wrap;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.hairline;
}

// A status dot. tone: 0 neutral, 1 warning, 2 problem, 3 accent/info, 4 ok, 5 pending (pulsing ring).
export component StatusDot {
    in property <int> tone;
    property <color> c: root.tone == 2 ? Theme.error : root.tone == 1 ? Theme.warn : root.tone == 3 || root.tone == 5 ? Theme.accent : root.tone == 4 ? Theme.ok : Theme.text-tertiary;
    width: 8px;
    min-height: 8px;
    accessible-role: none;
    Rectangle {
        y: (root.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.c;
        if root.tone == 5 && !Theme.reduce-motion: Rectangle {
            property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
            x: -4px * self.phase;
            y: -4px * self.phase;
            width: 8px + 8px * self.phase;
            height: self.width;
            border-radius: self.width / 2;
            border-width: 1.5px;
            border-color: Theme.accent.with-alpha(0.6 * (1 - self.phase));
        }
    }
}

// Small status capsule with text. tone: 0 neutral, 1 warning, 2 problem, 3 accent/info, 4 ok.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    in property <bool> dot;
    property <color> c: root.tone == 2 ? Theme.error : root.tone == 1 ? Theme.warn : root.tone == 3 ? Theme.accent : root.tone == 4 ? Theme.ok : Theme.text-secondary;
    height: 20px;
    width: row.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: root.c.with-alpha(root.tone == 0 ? 0.10 : 0.13);
    border-width: 1px;
    border-color: root.c.with-alpha(0.26);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding-left: root.dot ? 7px : 8px;
        padding-right: 8px;
        spacing: 5px;
        if root.dot: Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.c;
        }
        Text { text: root.text; font-size: Theme.font-caption; font-weight: 600; color: root.c; vertical-alignment: center; }
    }
}

// Inline message. kind: 0 info/working, 1 ok, 2 problem, 3 warning, 4 pending (spinner). Trailing actions go inside.
export component StatusBanner inherits Rectangle {
    in property <int> kind;
    in property <string> message;
    property <color> c: root.kind == 2 ? Theme.error : root.kind == 1 ? Theme.ok : root.kind == 3 ? Theme.warn : Theme.accent;
    min-height: row.preferred-height;
    border-radius: Theme.radius-m;
    background: root.c.with-alpha(Theme.dark ? 0.09 : 0.08);
    border-width: 1px;
    border-color: root.c.with-alpha(0.24);
    accessible-role: text;
    accessible-label: root.message;
    row := HorizontalLayout {
        padding-top: 7px;
        padding-bottom: 7px;
        padding-left: 11px;
        padding-right: 7px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            if root.kind == 4: Spinner { tint: root.c; size: 15px; }
            if root.kind != 4: Icon {
                width: 15px;
                height: 15px;
                source: root.kind == 2 ? @image-url("assets/icons/circle-x.svg") : root.kind == 1 ? @image-url("assets/icons/circle-check.svg") : root.kind == 3 ? @image-url("assets/icons/triangle-alert.svg") : @image-url("assets/icons/info.svg");
                tint: root.c;
            }
        }
        Text { text: root.message; wrap: word-wrap; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; min-height: 20px; horizontal-stretch: 1; }
        @children
    }
}

// A calm content card with the glass bevel lighting. tone tints the edge for states (1 warning, 2 problem,
// 3 accent, 4 ok); interactive cards light up on hover.
export component Card inherits Rectangle {
    in property <int> tone;
    in property <bool> interactive;
    in property <bool> selected;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    border-radius: Theme.radius-l;
    GlassFrame {
        f: GlassEngine.card;
        inner-width: root.width;
        inner-height: root.height;
    }
    body := Rectangle {
        border-radius: Theme.radius-l;
        background: root.selected ? Theme.accent.with-alpha(0.10) : root.interactive && touch.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: 1px;
        border-color: root.tone == 2 ? Theme.error.with-alpha(0.42) : root.tone == 1 ? Theme.warn.with-alpha(0.38) : root.selected || (root.interactive && touch.has-hover) ? Theme.accent.with-alpha(0.42) : Theme.hairline;
        animate background, border-color { duration: Theme.quick; easing: ease-out; }
    }
    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
    @children
}

// Page title, an optional one-line subtitle and the page's actions at the top right.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Theme.space-l;
    padding-bottom: Theme.space-xs;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        alignment: center;
        Text { text: root.title; font-size: Theme.font-page; font-weight: 700; color: Theme.text; letter-spacing: -0.5px; accessible-role: text; }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.font-small; }
    }
    HorizontalLayout {
        horizontal-stretch: 0;
        spacing: Theme.space-s;
        alignment: end;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.space-s;
                @children
            }
        }
    }
}

// A titled group inside a pane: title (+ optional caption) on the left, actions on the right.
export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> caption;
    spacing: Theme.space-m;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        Text { text: root.title; font-size: Theme.font-emphasis; font-weight: 650; color: Theme.text; }
        if root.caption != "": Secondary { text: root.caption; }
    }
    HorizontalLayout {
        horizontal-stretch: 0;
        spacing: Theme.space-s;
        alignment: end;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.space-s;
                @children
            }
        }
    }
}

// Nothing to show (yet): an icon and a quiet sentence.
export component EmptyState inherits VerticalLayout {
    in property <string> text;
    in property <image> icon: @image-url("assets/icons/info.svg");
    padding: Theme.space-2xl;
    spacing: Theme.space-s;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: Theme.fill-subtle;
            Icon { source: root.icon; width: 17px; height: 17px; tint: Theme.text-tertiary; }
        }
    }
    Text { text: root.text; color: Theme.text-secondary; font-size: Theme.font-body; wrap: word-wrap; horizontal-alignment: center; }
}

// A labelled field: the label above the control, so columns of fields stay compact.
export component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Text { text: root.label; font-size: Theme.font-small; font-weight: 500; color: Theme.text-secondary; }
    @children
}

// A settings-style row: label (and caption) on the left, the control on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> caption;
    spacing: Theme.space-l;
    padding-top: Theme.space-s;
    padding-bottom: Theme.space-s;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        Text { text: root.label; font-size: Theme.font-body; font-weight: 500; color: Theme.text; wrap: word-wrap; }
        if root.caption != "": Secondary { text: root.caption; }
    }
    HorizontalLayout {
        horizontal-stretch: 0;
        alignment: end;
        spacing: Theme.space-s;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: Theme.space-s;
                @children
            }
        }
    }
}

// Sidebar entry: the selected page sits on a softly lit capsule with an accent indicator.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <string> note;
    in property <int> note-tone;
    callback clicked;
    property <bool> kbd;
    height: 34px;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.10) : (touch.has-hover ? Theme.fill-hover : transparent);
    border-width: root.kbd ? 2px : (root.selected ? 1px : 0px);
    border-color: root.kbd ? Theme.focus-ring : Theme.accent.with-alpha(0.22);
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    FocusScope {
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: Theme.smooth; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            width: 16px;
            height: 16px;
            tint: root.selected ? Theme.accent : (touch.has-hover ? Theme.text : Theme.text-secondary);
        }
        Text {
            text: root.label;
            font-size: Theme.font-body;
            font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.note != "": VerticalLayout {
            alignment: center;
            Badge { text: root.note; tone: root.note-tone; }
        }
    }
}

// A row of a grouped list inside a pane: leading icon chip, title and lines, trailing actions; a hairline
// separates it from the next row.
export component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> detail;
    in property <image> icon;
    // 0 neutral, 1 warning, 2 problem, 3 accent, 4 ok.
    in property <int> tone;
    in property <bool> last;
    in property <bool> wrap-title;
    property <color> c: root.tone == 2 ? Theme.error : root.tone == 1 ? Theme.warn : root.tone == 4 ? Theme.ok : Theme.accent;
    min-height: row.preferred-height;
    accessible-role: list-item;
    accessible-label: root.title;
    if !root.last: Rectangle {
        x: root.icon.width > 0 ? 52px : 14px;
        y: parent.height - 1px;
        width: parent.width - self.x - 14px;
        height: 1px;
        background: Theme.hairline;
    }
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        if root.icon.width > 0: VerticalLayout {
            alignment: start;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: root.tone == 0 ? Theme.fill-hover : root.c.with-alpha(0.14);
                Icon { source: root.icon; width: 15px; height: 15px; tint: root.tone == 0 ? Theme.text-secondary : root.c; }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                wrap: root.wrap-title ? word-wrap : no-wrap;
            }
            if root.subtitle != "": Text { text: root.subtitle; font-size: Theme.font-small; color: root.tone == 2 ? Theme.error : root.tone == 1 ? Theme.warn : Theme.text-secondary; wrap: word-wrap; }
            if root.detail != "": Text { text: root.detail; font-size: Theme.font-small; color: Theme.text-tertiary; wrap: word-wrap; }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            alignment: end;
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    @children
                }
            }
        }
    }
}
