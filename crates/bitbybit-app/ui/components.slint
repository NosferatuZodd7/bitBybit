// Reusable Liquid Glass components. Glass is used for the navigation/control layer and floating surfaces; content
// sits on calmer surfaces. Every interactive element has hover/pressed feedback and an accessible role/label.

import { Theme } from "theme.slint";

// The luminous backdrop the glass sits on: a vertical gradient with three soft glows (drawn by the app: no backdrop
// blur needed, identical on Windows 10 and 11).
export component Backdrop inherits Rectangle {
    background: @linear-gradient(170deg, Theme.bg-top 0%, Theme.bg-bottom 100%);
    clip: true;
    Rectangle {
        x: -root.width * 0.2;
        y: -root.height * 0.35;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.glow-a 0%, Theme.glow-a.with-alpha(0) 70%);
    }
    Rectangle {
        x: root.width * 0.55;
        y: root.height * 0.05;
        width: root.width * 0.7;
        height: self.width;
        background: @radial-gradient(circle, Theme.glow-b 0%, Theme.glow-b.with-alpha(0) 70%);
    }
    Rectangle {
        x: root.width * 0.15;
        y: root.height * 0.6;
        width: root.width * 0.8;
        height: self.width;
        background: @radial-gradient(circle, Theme.glow-c 0%, Theme.glow-c.with-alpha(0) 70%);
    }
}

// A glass layer: translucent fill, hairline edge, a specular highlight along the top and a soft diffuse shadow.
export component Glass inherits Rectangle {
    in property <bool> strong;
    in property <bool> raised: true;
    border-radius: Theme.radius-l;
    background: root.strong ? Theme.glass-strong : Theme.glass;
    border-width: 1px;
    border-color: Theme.edge;
    drop-shadow-color: root.raised ? Theme.shadow : transparent;
    drop-shadow-blur: root.raised ? 24px : 0px;
    drop-shadow-offset-y: root.raised ? 8px : 0px;
    // Specular line: light catching the top edge of the glass.
    Rectangle {
        x: root.border-radius * 0.6;
        y: 1px;
        width: root.width - root.border-radius * 1.2;
        height: 1px;
        background: @linear-gradient(90deg, Theme.highlight.with-alpha(0) 0%, Theme.highlight 50%, Theme.highlight.with-alpha(0) 100%);
    }
    @children
}

// A content card: calmer than glass; an optional semantic edge (0 none, 1 warning, 2 problem, 3 accent).
export component Card inherits Rectangle {
    in property <int> tone;
    in property <bool> interactive;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    border-radius: Theme.radius-m;
    background: root.interactive && touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.tone == 2 ? Theme.error.with-alpha(0.65) : root.tone == 1 ? Theme.warn.with-alpha(0.6) : root.tone == 3 ? Theme.accent.with-alpha(0.6) : Theme.edge;
    animate background { duration: Theme.quick; easing: ease-out; }
    touch := TouchArea {
        enabled: root.interactive;
        clicked => { root.clicked(); }
    }
    @children
}

// Capsule button. kind: 0 secondary (glass), 1 primary (accent), 2 destructive, 3 quiet (text only).
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.control-height;
    min-width: label.preferred-width + 28px;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    background: root.kind == 1 ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : root.kind == 2 ? (touch.has-hover ? Theme.error.with-alpha(0.32) : Theme.error.with-alpha(0.2))
        : root.kind == 3 ? (touch.has-hover ? Theme.surface-hover : transparent)
        : (touch.has-hover ? Theme.surface-hover : Theme.glass);
    border-width: root.kind == 0 || root.kind == 2 ? 1px : 0px;
    border-color: root.kind == 2 ? Theme.error.with-alpha(0.55) : Theme.edge;
    animate background { duration: Theme.quick; easing: ease-out; }
    // Pressed feedback: a slight dip.
    property <float> press: touch.pressed && root.enabled ? 0.97 : 1;
    animate press { duration: Theme.quick; }
    label := Text {
        text: root.text;
        font-size: Theme.font-body;
        font-weight: root.kind == 1 || root.kind == 2 ? 600 : 500;
        color: root.kind == 1 ? Theme.on-accent : root.kind == 2 ? Theme.error : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width * root.press;
        height: parent.height * root.press;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Sidebar entry: the selected item sits on an accent-tinted glass pill with a small indicator.
export component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked;
    height: 38px;
    border-radius: self.height / 2;
    background: root.selected ? Theme.accent-soft : (touch.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 6px;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: Theme.smooth; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: 15px; color: root.selected ? Theme.accent : Theme.text-secondary; vertical-alignment: center; width: 18px; horizontal-alignment: center; }
        Text { text: root.label; font-size: Theme.font-body; font-weight: root.selected ? 600 : 400; color: Theme.text; vertical-alignment: center; overflow: elide; }
    }
}

// Small status capsule. tone: 0 neutral, 1 warning, 2 problem, 3 accent, 4 ok.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> tone;
    property <color> c: root.tone == 2 ? Theme.error : root.tone == 1 ? Theme.warn : root.tone == 3 ? Theme.accent : root.tone == 4 ? Theme.ok : Theme.text-secondary;
    height: 20px;
    width: t.preferred-width + 16px;
    border-radius: self.height / 2;
    background: root.c.with-alpha(0.16);
    border-width: 1px;
    border-color: root.c.with-alpha(0.35);
    t := Text { text: root.text; font-size: 11px; font-weight: 600; color: root.c; horizontal-alignment: center; vertical-alignment: center; }
}

// Banner for state and feedback. kind: 0 working/info, 1 ok, 2 problem, 3 warning.
export component StatusBanner inherits Rectangle {
    in property <int> kind;
    in property <string> message;
    property <color> c: root.kind == 2 ? Theme.error : root.kind == 1 ? Theme.ok : root.kind == 3 ? Theme.warn : Theme.accent;
    min-height: row.preferred-height;
    border-radius: Theme.radius-m;
    background: root.c.with-alpha(0.12);
    border-width: 1px;
    border-color: root.c.with-alpha(0.35);
    accessible-role: text;
    accessible-label: root.message;
    row := HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-m;
        spacing: Theme.space-s;
        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.c; y: (parent.height - self.height) / 2; }
        Text { text: root.message; wrap: word-wrap; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
        @children
    }
}

// Page title with an optional subtitle and trailing actions.
export component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: Theme.space-m;
    VerticalLayout {
        spacing: 2px;
        Text { text: root.title; font-size: Theme.font-page; font-weight: 700; color: Theme.text; accessible-role: text; }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.text-secondary; wrap: word-wrap; font-size: Theme.font-body; }
    }
    @children
}

export component SectionTitle inherits Text {
    font-size: Theme.font-title;
    font-weight: 650;
    color: Theme.text;
}

export component Secondary inherits Text {
    font-size: Theme.font-caption;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

export component Body inherits Text {
    font-size: Theme.font-body;
    color: Theme.text;
    wrap: word-wrap;
}

// Segmented control (themes, channels): the selected segment is a raised glass pill.
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback changed(int);
    height: Theme.control-height + 6px;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.edge;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: self.height / 2;
            background: i == root.selected ? Theme.accent : (seg-touch.has-hover ? Theme.surface-hover : transparent);
            animate background { duration: Theme.quick; easing: ease-out; }
            min-width: seg-label.preferred-width + 24px;
            accessible-role: tab;
            accessible-label: item;
            accessible-item-selected: i == root.selected;
            seg-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected = i; root.changed(i); }
            }
            seg-label := Text {
                text: item;
                font-size: Theme.font-body;
                font-weight: i == root.selected ? 600 : 400;
                color: i == root.selected ? Theme.on-accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
