// Ecrãs (DSP-03) and audio format (AUD-07) pieces. Texts come in as properties (the Tr global lives in app.slint).

import { Theme } from "theme.slint";
import { Icon, Button, Select } from "controls.slint";
import { Panel, Badge } from "components.slint";

// A choice list with an apply button: the list holds only what the device reports, the one in use is preselected,
// and the button is enabled only for a different choice (the change itself is confirmed in a dialog first).
export component ChoiceApply inherits HorizontalLayout {
    in property <[string]> model;
    // Index of what is in use now (-1 unknown).
    in property <int> current;
    in property <string> action;
    in property <string> label;
    callback apply(int);
    spacing: 8px;
    pick := Select {
        model: root.model;
        current-index: root.current;
        accessible-label: root.label;
    }
    VerticalLayout {
        alignment: center;
        Button {
            text: root.action;
            size: 1;
            kind: 1;
            enabled: pick.current-index >= 0 && pick.current-index != root.current;
            clicked => { root.apply(pick.current-index); }
        }
    }
}

// "Keep these display settings?" with the countdown driven by the worker (it reverts by itself at zero).
export component DisplayKeepDialog inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> countdown;
    in property <string> keep-text;
    in property <string> revert-text;
    callback answer(bool);
    background: Theme.scrim;
    TouchArea { }
    Panel {
        width: min(root.width - 64px, 540px);
        height: min(root.height - 64px, box.preferred-height);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1.5px;
        border-color: Theme.amber;
        accessible-role: groupbox;
        accessible-label: root.title + " " + root.countdown;
        box := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 42px;
                    height: 42px;
                    border-radius: 10px;
                    background: Theme.inset;
                    Icon { width: 18px; height: 18px; source: @image-url("assets/icons/monitor.svg"); tint: Theme.amber; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.title; font-size: Theme.font-title + 1px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                    Text { text: root.detail; font-size: Theme.font-body; color: Theme.text-secondary; wrap: word-wrap; }
                }
            }
            Text { text: root.countdown; font-size: Theme.font-title; font-weight: 700; color: Theme.amber; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { text: root.revert-text; clicked => { root.answer(false); } }
                Button { text: root.keep-text; kind: 1; clicked => { root.answer(true); } }
            }
        }
    }
}

// One refresh rate of a resolution: the button applies (or tests) it after the usual confirmation.
export struct ModeRate { label: string, tag: string, tone: int, index: int, can-apply: bool }
// The modes of one resolution, from the driver's list and the monitor's EDID.
export struct ModeGroup { resolution: string, native: bool, rates: [ModeRate] }
// One typed line of the limitation explanation (kind: "Facto confirmado", "Hipótese", …; level 0–3).
export struct LimitLine { kind: string, text: string, level: int }

// Per display: what the monitor announces, the modes grouped by resolution with their tags, and — when the
// native mode is missing — why, from the data only (typed evidence) and what would have to change (advice).
export component DisplayDetails inherits VerticalLayout {
    in property <string> caps;
    in property <[ModeGroup]> groups;
    in property <[LimitLine]> limits;
    in property <[string]> guidance;
    in property <string> modes-title;
    in property <string> legend;
    in property <string> limit-title;
    in property <string> guidance-title;
    callback pick(int);
    spacing: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-bottom: 14px;
    if root.caps != "": Text { text: root.caps; font-size: Theme.font-small; color: Theme.text-secondary; wrap: word-wrap; }
    if root.limits.length > 0: Rectangle {
        border-radius: Theme.radius-control;
        background: Theme.amber.with-alpha(0.10);
        height: lim.preferred-height;
        Rectangle { x: 0; width: 3px; border-radius: 1.5px; background: Theme.amber; }
        lim := VerticalLayout {
            padding: 12px;
            padding-left: 16px;
            spacing: 6px;
            Text { text: root.limit-title; font-size: Theme.font-body; font-weight: 700; color: Theme.text; wrap: word-wrap; }
            // One wrapped Text per line (wrapped text inside a horizontal row under-reports its height).
            for line in root.limits: Text {
                text: line.kind + " — " + line.text;
                font-size: Theme.font-small;
                color: line.level >= 3 ? Theme.amber : line.level == 2 ? Theme.cyan : Theme.text;
                wrap: word-wrap;
            }
            if root.guidance.length > 0: Text { text: root.guidance-title; font-size: Theme.font-small; font-weight: 700; color: Theme.text; }
            for g in root.guidance: Text { text: "•  " + g; font-size: Theme.font-small; color: Theme.text-secondary; wrap: word-wrap; }
        }
    }
    if root.groups.length > 0: Text { text: root.modes-title; font-size: Theme.font-small; font-weight: 700; color: Theme.text; }
    for group in root.groups: HorizontalLayout {
        spacing: 10px;
        Text {
            width: 120px;
            text: group.resolution;
            font-size: Theme.font-small;
            font-weight: group.native ? 700 : 500;
            color: Theme.text;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for rate in group.rates: HorizontalLayout {
                spacing: 4px;
                Button { text: rate.label; size: 1; enabled: rate.can-apply; clicked => { root.pick(rate.index); } }
                if rate.tag != "": VerticalLayout { alignment: center; Badge { text: rate.tag; tone: rate.tone; } }
            }
        }
    }
    if root.groups.length > 0: Text { text: root.legend; font-size: Theme.font-caption; color: Theme.text-muted; wrap: word-wrap; }
}
