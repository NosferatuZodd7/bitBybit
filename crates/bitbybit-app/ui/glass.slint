// Liquid Glass surfaces. The images come from the native renderer (src/glass.rs, a port of the LiquidGlass
// shader): panes refract the backdrop at their window position; frames add the bevel lighting to cards and controls.
// Every surface keeps a flat Slint fallback underneath, shown while an image renders or when glass is off.

import { Theme } from "theme.slint";

export struct GlassFrameImages {
    tl: image, tr: image, bl: image, br: image,
    t: image, b: image, l: image, r: image,
    corner: length, pad: length,
}

export global GlassEngine {
    // false: Windows "Transparency effects" off, no worker, or BITBYBIT_GLASS=0 — the flat glass is used.
    in property <bool> enabled;
    // Bumped by Rust when a rendered image is ready (re-evaluates the bindings below).
    in property <int> revision;
    in property <GlassFrameImages> card;
    in property <GlassFrameImages> control;
    in property <GlassFrameImages> thumb;
    in property <GlassFrameImages> large;
    // (id, kind, x, y, width, height, revision): kind 0 navigation, 1 page pane, 2 dialog, 3 toast.
    pure callback pane(string, int, length, length, length, length, int) -> image;
    pure callback backdrop(length, length, int) -> image;
}

// The window backdrop: rendered (so panes refract exactly what is around them), with the gradient as fallback.
export component Backdrop inherits Rectangle {
    property <image> img: GlassEngine.enabled ? GlassEngine.backdrop(root.width, root.height, GlassEngine.revision) : root.no-image;
    property <image> no-image;
    background: @linear-gradient(160deg, Theme.bg-top 0%, Theme.bg-bottom 75%);
    clip: true;
    if root.img.width == 0: Rectangle {
        x: -root.width * 0.3;
        y: -root.height * 0.6;
        width: root.width * 1.1;
        height: self.width;
        background: @radial-gradient(circle, Theme.glow-a 0%, Theme.glow-a.with-alpha(0) 65%);
    }
    if root.img.width == 0: Rectangle {
        x: root.width * 0.45;
        y: -root.height * 0.3;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.glow-b 0%, Theme.glow-b.with-alpha(0) 65%);
    }
    Image {
        width: root.width;
        height: root.height;
        // The rendered size follows the window: it must not feed back into the window's layout.
        preferred-width: 0px;
        preferred-height: 0px;
        source: root.img;
        image-fit: fill;
        accessible-role: none;
    }
}

// The bevel lighting of a card or control: eight slices around the element (corners at their own size, edges
// stretched), including the soft shadow. Place it first inside the element; it extends `pad` beyond it.
export component GlassFrame {
    in property <GlassFrameImages> f;
    in property <length> inner-width;
    in property <length> inner-height;
    property <length> c: root.f.corner;
    property <length> mw: max(0px, root.width - 2 * root.c);
    property <length> mh: max(0px, root.height - 2 * root.c);
    x: -root.f.pad;
    y: -root.f.pad;
    width: root.inner-width + 2 * root.f.pad;
    height: root.inner-height + 2 * root.f.pad;
    visible: GlassEngine.enabled && root.c > 0;
    accessible-role: none;
    Image { x: 0; y: 0; width: root.c; height: root.c; source: root.f.tl; image-fit: fill; }
    Image { x: root.c; y: 0; width: root.mw; height: root.c; source: root.f.t; image-fit: fill; }
    Image { x: root.width - root.c; y: 0; width: root.c; height: root.c; source: root.f.tr; image-fit: fill; }
    Image { x: 0; y: root.c; width: root.c; height: root.mh; source: root.f.l; image-fit: fill; }
    Image { x: root.width - root.c; y: root.c; width: root.c; height: root.mh; source: root.f.r; image-fit: fill; }
    Image { x: 0; y: root.height - root.c; width: root.c; height: root.c; source: root.f.bl; image-fit: fill; }
    Image { x: root.c; y: root.height - root.c; width: root.mw; height: root.c; source: root.f.b; image-fit: fill; }
    Image { x: root.width - root.c; y: root.height - root.c; width: root.c; height: root.c; source: root.f.br; image-fit: fill; }
}

// A refracting glass pane that stays where it is (navigation, page panes, dialogs, toasts). Content goes inside and
// is clipped to the rounded shape; scrolling happens inside the pane, never by moving it.
export component GlassPane {
    // Unique per visible pane: the renderer keeps one image per id.
    in property <string> glass-id;
    // 0 navigation, 1 page pane, 2 dialog, 3 toast (radius and material match src/glass.rs).
    in property <int> kind: 1;
    out property <length> radius: root.kind == 0 ? 20px : root.kind == 2 ? 22px : root.kind == 3 ? 16px : 18px;
    property <length> pad: 32px;
    property <image> no-image;
    property <image> img: GlassEngine.enabled ? GlassEngine.pane(root.glass-id, root.kind, root.absolute-position.x, root.absolute-position.y, root.width, root.height, GlassEngine.revision) : root.no-image;
    property <bool> rendered: root.img.width > 0;
    // Flat glass: the fallback, and what shows for the first frames while the image renders.
    Rectangle {
        border-radius: root.radius;
        background: root.kind == 2 || root.kind == 3 ? Theme.glass-strong : root.kind == 0 ? Theme.glass : Theme.surface;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-color: Theme.shadow.with-alpha(0.35);
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        visible: !root.rendered;
    }
    Image {
        x: -root.pad;
        y: -root.pad;
        width: root.width + 2 * root.pad;
        height: root.height + 2 * root.pad;
        source: root.img;
        image-fit: fill;
        accessible-role: none;
    }
    Rectangle {
        border-radius: root.radius;
        clip: true;
        @children
    }
}
