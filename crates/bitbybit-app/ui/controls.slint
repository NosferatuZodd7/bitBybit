// Controls of the bitBybit design system: flat, compact, pill-shaped like the specification's "Detail" buttons and
// search field. Every control has hover, pressed, keyboard-focus (Tab only), disabled and, where it applies,
// loading states, and an accessible role. Icons are Lucide SVGs (ISC, third-party/lucide).

import { Theme } from "theme.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text-secondary;
    width: 16px;
    height: 16px;
    colorize: root.tint;
    image-fit: contain;
    accessible-role: none;
}

// Indeterminate progress (static when Windows asks for reduced animations).
export component Spinner {
    in property <color> tint: Theme.text-secondary;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    accessible-role: progress-indicator;
    Image {
        width: root.size;
        height: root.size;
        source: @image-url("assets/icons/loader-circle.svg");
        colorize: root.tint;
        transform-rotation: Theme.reduce-motion ? 0deg : Math.mod(animation-tick() / 1ms, 900) * 0.4deg;
    }
}

component FocusRing inherits Rectangle {
    in property <length> radius;
    in property <length> around-width;
    in property <length> around-height;
    x: -3px;
    y: -3px;
    width: root.around-width + 6px;
    height: root.around-height + 6px;
    border-radius: root.radius + 3px;
    border-width: 2px;
    border-color: Theme.focus;
}

// Pill button. kind: 0 neutral, 1 primary (green), 2 danger, 3 text only, 4 on a coloured card.
// size: 0 regular (34 px), 1 small (28 px).
export component Button {
    in property <string> text;
    in property <image> icon;
    in property <int> kind;
    in property <int> size;
    in property <bool> enabled: true;
    in property <bool> loading;
    // true: takes the width its layout gives it (otherwise never wider than its label).
    in property <bool> stretch;
    callback clicked;
    property <bool> active: root.enabled && !root.loading;
    property <bool> kbd;
    property <length> h: root.size == 1 ? Theme.control-height-s : Theme.control-height;
    property <color> fg: root.kind == 1 ? #FFFFFF : root.kind == 2 ? Theme.red : Theme.text;
    height: root.h;
    min-width: row.preferred-width;
    max-width: root.stretch ? 100000px : row.preferred-width;
    horizontal-stretch: root.stretch ? 1 : 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.active;
    accessible-action-default => { if (root.active) { root.clicked(); } }
    Rectangle {
        border-radius: root.h / 2;
        background: root.kind == 1 ? (touch.pressed ? Theme.green.darker(0.15) : touch.has-hover && root.active ? Theme.green.brighter(0.08) : Theme.green)
            : root.kind == 2 ? (touch.pressed ? Theme.red.with-alpha(0.32) : touch.has-hover && root.active ? Theme.red.with-alpha(0.24) : Theme.red.with-alpha(0.15))
            : root.kind == 3 ? (touch.pressed ? Theme.control-press : touch.has-hover && root.active ? Theme.control : transparent)
            : root.kind == 4 ? (touch.pressed ? #FFFFFF47 : touch.has-hover && root.active ? #FFFFFF3D : #FFFFFF2E)
            : (touch.pressed ? Theme.control-press : touch.has-hover && root.active ? Theme.control-hover : Theme.control);
        animate background { duration: Theme.quick; }
    }
    if root.kbd: FocusRing { radius: root.h / 2; around-width: root.width; around-height: root.height; }
    FocusScope {
        enabled: root.active;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? pointer : default;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: root.kind == 3 ? 10px : (root.size == 1 ? 14px : 18px);
        padding-right: root.kind == 3 ? 10px : (root.size == 1 ? 14px : 18px);
        spacing: 7px;
        alignment: center;
        if root.loading: Spinner { y: (parent.height - self.height) / 2; tint: root.fg; size: 14px; }
        if !root.loading && root.icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            tint: root.fg;
            width: 14px;
            height: 14px;
        }
        Text {
            text: root.text;
            font-size: root.size == 1 ? Theme.font-small : Theme.font-body;
            font-weight: 600;
            color: root.fg;
            vertical-alignment: center;
        }
    }
}

// Square icon-only button with a tooltip (also its accessible name). badge: a count shown on the icon (0 = none).
export component IconButton {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <int> badge;
    in property <color> tint: Theme.text-secondary;
    callback clicked;
    property <bool> kbd;
    property <bool> hovering: touch.has-hover;
    width: 34px;
    height: 34px;
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    opacity: root.enabled ? 1 : 0.45;
    changed hovering => {
        if (!self.hovering) {
            tip.close();
        }
    }
    Rectangle {
        border-radius: Theme.radius-control;
        background: touch.pressed ? Theme.control-press : touch.has-hover && root.enabled ? Theme.control : transparent;
        animate background { duration: Theme.quick; }
    }
    if root.kbd: FocusRing { radius: Theme.radius-control; around-width: root.width; around-height: root.height; }
    Icon {
        width: 18px;
        height: 18px;
        source: root.icon;
        tint: touch.has-hover ? Theme.text : root.tint;
    }
    if root.badge > 0: Rectangle {
        x: parent.width - 14px;
        y: 3px;
        width: max(15px, count.preferred-width + 8px);
        height: 15px;
        border-radius: 7.5px;
        background: Theme.red;
        count := Text { text: root.badge; font-size: 9px; font-weight: 700; color: #FFFFFF; }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            tip.close();
            root.clicked();
        }
    }
    Timer {
        interval: 550ms;
        running: touch.has-hover && root.tooltip != "";
        triggered => {
            self.running = false;
            tip.show();
        }
    }
    tip := PopupWindow {
        close-policy: no-auto-close;
        x: (root.width - self.width) / 2;
        y: root.height + 6px;
        width: tip-text.preferred-width + 16px;
        height: 24px;
        Rectangle {
            border-radius: 6px;
            background: Theme.app-bg;
            border-width: 1px;
            border-color: Theme.divider;
            tip-text := Text { text: root.tooltip; font-size: Theme.font-small; color: Theme.text; }
        }
    }
}

// Switch. `toggled` fires after `checked` changed.
export component Toggle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    property <bool> kbd;
    min-height: 22px;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 38px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            background: root.checked ? Theme.green : (touch.has-hover && root.enabled ? Theme.control-hover : Theme.control);
            animate background { duration: Theme.quick; }
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.checked ? #FFFFFF : Theme.text-secondary;
                animate x { duration: Theme.quick; easing: ease-out; }
            }
            if root.kbd: FocusRing { radius: 11px; around-width: 38px; around-height: 22px; }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// Check box. `toggled` fires after `checked` changed.
export component Check {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    property <bool> kbd;
    min-height: 20px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; root.toggled(); } }
    opacity: root.enabled ? 1 : 0.45;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.checked ? Theme.green : Theme.inset;
            border-width: root.checked ? 0px : 1.5px;
            border-color: touch.has-hover ? Theme.text-secondary : Theme.text-muted;
            if root.checked: Icon { width: 12px; height: 12px; source: @image-url("assets/icons/check.svg"); tint: #FFFFFF; }
            if root.kbd: FocusRing { radius: 5px; around-width: 18px; around-height: 18px; }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.font-body;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == " ") {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

// Single-line text field. `pill` gives the rounded search-field shape; trailing children sit inside on the right.
export component TextField {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <bool> pill;
    in property <image> leading-icon;
    callback accepted(string);
    callback edited(string);
    property <bool> focused: input.has-focus;
    height: Theme.control-height;
    min-width: 96px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        border-radius: root.pill ? self.height / 2 : Theme.radius-control;
        background: Theme.control;
        border-width: 1px;
        border-color: root.focused ? Theme.cyan : (hover.has-hover && root.enabled ? Theme.control-press : Theme.control);
        animate border-color { duration: Theme.quick; }
    }
    hover := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    HorizontalLayout {
        padding-left: root.pill ? 16px : 12px;
        padding-right: root.pill ? 12px : 4px;
        spacing: 8px;
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                width: parent.width;
                text: root.placeholder-text;
                color: Theme.text-muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                font-size: Theme.font-body;
                color: Theme.text;
                selection-background-color: Theme.cyan.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                input-type: root.input-type;
                single-line: true;
                enabled: root.enabled;
                accessible-label: root.placeholder-text;
                accepted => { root.accepted(self.text); }
                edited => { root.edited(self.text); }
            }
        }
        if root.leading-icon.width > 0: Icon { y: (parent.height - self.height) / 2; source: root.leading-icon; tint: Theme.text-muted; }
        @children
    }
}

// Drop-down list (same contract as std ComboBox: model, current-index, `selected(value)`). `pill`: the compact
// rounded selector of the specification's chart panel.
export component Select {
    in property <[string]> model;
    in-out property <int> current-index;
    out property <string> current-value: root.model[root.current-index];
    in property <bool> enabled: true;
    in property <bool> pill;
    callback selected(string);
    property <bool> kbd;
    height: root.pill ? Theme.control-height-s : Theme.control-height;
    min-width: root.pill ? row.preferred-width : 140px;
    horizontal-stretch: root.pill ? 0 : 1;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-value: root.current-value;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { popup.show(); } }
    function pick(i: int) {
        if (i >= 0 && i < root.model.length && i != root.current-index) {
            root.current-index = i;
            root.selected(root.model[i]);
        }
    }
    if root.kbd: FocusRing { radius: root.pill ? root.height / 2 : Theme.radius-control; around-width: root.width; around-height: root.height; }
    Rectangle {
        border-radius: root.pill ? self.height / 2 : Theme.radius-control;
        background: touch.pressed ? Theme.control-press : touch.has-hover && root.enabled ? Theme.control-hover : Theme.control;
        animate background { duration: Theme.quick; }
    }
    row := HorizontalLayout {
        padding-left: root.pill ? 14px : 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.current-value;
            font-size: root.pill ? Theme.font-small : Theme.font-body;
            font-weight: root.pill ? 600 : 400;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            source: @image-url("assets/icons/chevron-down.svg");
        }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.pick(root.current-index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pick(root.current-index + 1);
                return accept;
            }
            if (event.text == " " || event.text == "\n") {
                popup.show();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: root.pill ? root.width - self.width : 0;
        y: root.height + 4px;
        width: max(root.width, 200px);
        height: min(list.preferred-height, 300px);
        Rectangle {
            border-radius: Theme.radius-card;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
        }
        Flickable {
            content-height: list.preferred-height;
            list := VerticalLayout {
                padding: 5px;
                spacing: 1px;
                for item[i] in root.model: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: item-touch.has-hover ? Theme.control : transparent;
                    accessible-role: list-item;
                    accessible-label: item;
                    accessible-item-selected: i == root.current-index;
                    accessible-action-default => { root.pick(i); popup.close(); }
                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.pick(i);
                            popup.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 8px;
                        Rectangle {
                            width: 14px;
                            if i == root.current-index: Icon { width: 14px; height: 14px; source: @image-url("assets/icons/check.svg"); tint: Theme.green; }
                        }
                        Text {
                            text: item;
                            font-size: Theme.font-body;
                            font-weight: i == root.current-index ? 600 : 400;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// badge: a short count after the label ("" = none).
export struct SegItem { label: string, icon: image, badge: string }

// Segmented tabs: a dark track with the chosen segment raised (the specification's period selector).
export component Segmented {
    in property <[SegItem]> items;
    in-out property <int> selected;
    in property <bool> enabled: true;
    in property <length> segment-min: 96px;
    callback changed(int);
    property <length> pad: 3px;
    property <int> n: max(1, root.items.length);
    property <length> seg-w: (root.width - 2 * root.pad) / root.n;
    property <bool> kbd;
    height: 36px;
    min-width: root.n * root.segment-min + 2 * root.pad;
    preferred-width: self.min-width;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: tab-list;
    function choose(i: int) {
        if (root.enabled && i >= 0 && i < root.items.length && i != root.selected) {
            root.selected = i;
            root.changed(i);
        }
    }
    Rectangle {
        border-radius: self.height / 2;
        background: Theme.inset;
    }
    if root.kbd: FocusRing { radius: root.height / 2; around-width: root.width; around-height: root.height; }
    Rectangle {
        x: root.pad + root.selected * root.seg-w;
        y: root.pad;
        width: root.seg-w;
        height: root.height - 2 * root.pad;
        border-radius: self.height / 2;
        background: Theme.control-hover;
        animate x { duration: Theme.quick; easing: ease-out; }
    }
    for item[i] in root.items: Rectangle {
        x: root.pad + i * root.seg-w;
        y: root.pad;
        width: root.seg-w;
        height: root.height - 2 * root.pad;
        accessible-role: tab;
        accessible-label: item.label;
        accessible-item-selected: i == root.selected;
        accessible-action-default => { root.choose(i); }
        seg-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.choose(i); }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 7px;
            padding-left: 8px;
            padding-right: 8px;
            if item.icon.width > 0: Icon {
                y: (parent.height - self.height) / 2;
                source: item.icon;
                tint: i == root.selected ? Theme.green : (seg-touch.has-hover ? Theme.text : Theme.text-secondary);
                width: 15px;
                height: 15px;
            }
            Text {
                text: item.label;
                font-size: Theme.font-small;
                font-weight: i == root.selected ? 600 : 500;
                color: i == root.selected ? Theme.text : (seg-touch.has-hover ? Theme.text : Theme.text-secondary);
                vertical-alignment: center;
                overflow: elide;
            }
            if item.badge != "": Rectangle {
                y: (parent.height - self.height) / 2;
                height: 17px;
                width: max(17px, count.preferred-width + 10px);
                border-radius: 8.5px;
                background: i == root.selected ? Theme.green : Theme.control;
                count := Text { text: item.badge; font-size: 10px; font-weight: 700; color: i == root.selected ? #FFFFFF : Theme.text-secondary; }
            }
        }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.choose(root.selected - 1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.choose(root.selected + 1);
                return accept;
            }
            reject
        }
    }
}

// Horizontal slider (same contract as std Slider: value, minimum, maximum, `released(value)`).
export component Slider {
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);
    property <float> ratio: (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum);
    property <bool> kbd;
    height: 22px;
    min-width: 120px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: slider;
    accessible-value: Math.round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: 5;
    accessible-enabled: root.enabled;
    function set-from(x: length) {
        root.value = Math.clamp(root.minimum + (x - 8px) / max(1px, root.width - 16px) * (root.maximum - root.minimum), root.minimum, root.maximum);
        root.changed(root.value);
    }
    function step(d: float) {
        root.value = Math.clamp(root.value + d, root.minimum, root.maximum);
        root.changed(root.value);
        root.released(root.value);
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.control;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 8px + root.ratio * (root.width - 16px);
        height: 4px;
        border-radius: 2px;
        background: Theme.green;
    }
    Rectangle {
        x: root.ratio * (root.width - 16px);
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #FFFFFF;
        if root.kbd: FocusRing { radius: 8px; around-width: 16px; around-height: 16px; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
            if (event.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
    FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.kbd = reason == FocusReason.tab-navigation; }
        focus-lost => { root.kbd = false; }
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.step(-5);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.step(5);
                return accept;
            }
            reject
        }
    }
}

export struct MenuEntry { label: string, icon: image, destructive: bool, enabled: bool }

// "More actions" button opening a menu; `activated(index)` reports the entry.
export component MenuButton {
    in property <[MenuEntry]> entries;
    in property <string> tooltip;
    callback activated(int);
    width: 34px;
    height: 34px;
    IconButton {
        icon: @image-url("assets/icons/ellipsis.svg");
        tooltip: root.tooltip;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 236px;
        height: entries-box.preferred-height;
        Rectangle {
            border-radius: Theme.radius-card;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
        }
        entries-box := VerticalLayout {
            padding: 5px;
            spacing: 1px;
            for e[i] in root.entries: Rectangle {
                height: 32px;
                border-radius: 6px;
                background: e.enabled && entry-touch.has-hover ? (e.destructive ? Theme.red.with-alpha(0.15) : Theme.control) : transparent;
                opacity: e.enabled ? 1 : 0.4;
                accessible-role: button;
                accessible-label: e.label;
                accessible-enabled: e.enabled;
                accessible-action-default => { if (e.enabled) { root.activated(i); menu.close(); } }
                entry-touch := TouchArea {
                    enabled: e.enabled;
                    mouse-cursor: pointer;
                    clicked => {
                        root.activated(i);
                        menu.close();
                    }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Icon { y: (parent.height - self.height) / 2; source: e.icon; tint: e.destructive ? Theme.red : Theme.text-secondary; }
                    Text { text: e.label; font-size: Theme.font-body; color: e.destructive ? Theme.red : Theme.text; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}
