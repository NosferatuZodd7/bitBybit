<Project Sdk="Microsoft.NET.Sdk">
  <!-- Integration tests against the real Windows APIs. Read-only by default; tests that change system state are
       opt-in via BITBYBIT_ALLOW_SYSTEM_CHANGES=1 and must only run on disposable VMs / CI runners. -->
  <PropertyGroup>
    <TargetFramework>$(BitByBitWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(BitByBitMinWindows)</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>BitByBit.Platform.Windows.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BitByBit.Core\BitByBit.Core.csproj" />
    <ProjectReference Include="..\..\src\BitByBit.Platform.Windows\BitByBit.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
