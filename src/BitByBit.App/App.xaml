<Application x:Class="BitByBit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:BitByBit.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Colours ("Brush.*") are published at runtime by Theming/ThemeManager; shapes, sizes and styles live in Theme.xaml. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theming/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <loc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <loc:EqualsConverter x:Key="EqualsConverter" />
      <loc:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
      <loc:AllEqualConverter x:Key="AllEqualConverter" />
      <loc:WidthToColumnsConverter x:Key="WidthToColumns" />
      <loc:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
