<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF desktop UI (pt-PT first). Runs unelevated; read-only queries run in-process, changes go through the broker. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(BitByBitWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(BitByBitMinWindows)</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the notification-area (tray) icon of the background mode. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 targets WinForms apps; this is a WPF app whose per-monitor DPI awareness belongs in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>bitBybit</AssemblyName>
    <RootNamespace>BitByBit.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BitByBit.Core\BitByBit.Core.csproj" />
    <ProjectReference Include="..\BitByBit.Platform.Windows\BitByBit.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF projects omit System.IO from implicit usings (name clash with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
    <!-- Keep WPF types unambiguous: WinForms/System.Drawing are referenced explicitly only by the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Inter (SIL OFL 1.1, third-party/inter/LICENSE.txt) bundled so the UI looks the same on every PC. -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
