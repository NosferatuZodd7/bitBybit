<Window x:Class="BitByBit.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BitByBit.App.Infrastructure"
        xmlns:vm="clr-namespace:BitByBit.App.ViewModels"
        xmlns:t="clr-namespace:BitByBit.App.Theming"
        Title="{loc:T app.settings.title}" Width="780" Height="600" MinWidth="680" MinHeight="480"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <t:GlassBackdrop />
    <Border Style="{StaticResource Surface.Panel}" Background="{DynamicResource Brush.Dialog}" Margin="16">
      <DockPanel Margin="18">
        <!-- Left navigation rail of sections -->
        <StackPanel DockPanel.Dock="Left" Width="190" Margin="0,0,18,0">
          <TextBlock Style="{StaticResource Text.Title}" Text="{loc:T app.settings.title}" Margin="6,0,0,14" />
          <Button Style="{StaticResource Chip}" Height="36" HorizontalContentAlignment="Left" Content="{loc:T app.settings.appearance}" t:Ux.Icon="sparkles"
                  Command="{Binding ShowSectionCommand}" CommandParameter="appearance" Margin="0,0,0,6"
                  t:Ux.Active="{Binding Section, Converter={StaticResource EqualsConverter}, ConverterParameter=appearance}" />
          <Button Style="{StaticResource Chip}" Height="36" Content="{loc:T app.settings.about}" t:Ux.Icon="info"
                  Command="{Binding ShowSectionCommand}" CommandParameter="about"
                  t:Ux.Active="{Binding Section, Converter={StaticResource EqualsConverter}, ConverterParameter=about}" />
        </StackPanel>

        <Grid>
          <!-- Appearance: every change is saved at once -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility}, ConverterParameter=appearance}">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.look}" Margin="2,4,0,6" />
              <Border Style="{StaticResource Surface.Card}" Padding="16">
                <StackPanel>
                  <WrapPanel>
                    <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.dark}" t:Ux.Icon="moon" Command="{Binding SetThemeCommand}" CommandParameter="dark"
                            t:Ux.Active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=dark}" />
                    <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.glass}" t:Ux.Icon="contrast" Command="{Binding SetThemeCommand}" CommandParameter="glass"
                            t:Ux.Active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=glass}" />
                    <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.light}" t:Ux.Icon="sun" Command="{Binding SetThemeCommand}" CommandParameter="light"
                            t:Ux.Active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=light}" />
                    <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.custom}" t:Ux.Icon="sparkles" Command="{Binding SetThemeCommand}" CommandParameter="custom"
                            t:Ux.Active="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=custom}" />
                  </WrapPanel>
                  <TextBlock Style="{StaticResource Text.Hint}" Text="{loc:T app.settings.lookHint}" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.customBase}" />
              <Border Style="{StaticResource Surface.Card}" Padding="16">
                <WrapPanel>
                  <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.dark}" Command="{Binding SetCustomBaseCommand}" CommandParameter="dark"
                          t:Ux.Active="{Binding CustomBase, Converter={StaticResource EqualsConverter}, ConverterParameter=dark}" />
                  <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.glass}" Command="{Binding SetCustomBaseCommand}" CommandParameter="glass"
                          t:Ux.Active="{Binding CustomBase, Converter={StaticResource EqualsConverter}, ConverterParameter=glass}" />
                  <Button Style="{StaticResource Chip}" Content="{loc:T app.theme.light}" Command="{Binding SetCustomBaseCommand}" CommandParameter="light"
                          t:Ux.Active="{Binding CustomBase, Converter={StaticResource EqualsConverter}, ConverterParameter=light}" />
                </WrapPanel>
              </Border>

              <DockPanel Margin="0,14,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="{loc:T app.settings.resetColours}" t:Ux.Icon="rotate-ccw" Command="{Binding ResetAllCommand}" Margin="0" />
                <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.colours}" Margin="2,0,0,0" VerticalAlignment="Center" />
              </DockPanel>
              <Border Style="{StaticResource Surface.Card}" Padding="16,10">
                <ItemsControl ItemsSource="{Binding Colours}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ColourRow}">
                      <DockPanel Margin="0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" t:Ux.Icon="rotate-ccw" t:Ux.IconSize="15" ToolTip="{loc:T app.settings.resetColour}" Command="{Binding ResetCommand}" />
                        <TextBox DockPanel.Dock="Right" Width="110" FontFamily="{StaticResource Font.Mono}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Margin="8,0" />
                        <Border DockPanel.Dock="Right" Width="34" Height="34" CornerRadius="9" Background="{Binding Preview}" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="Medium" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.suggestions}" />
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="38" Height="28" Margin="0,0,6,6" Cursor="Hand" ToolTip="{Binding}"
                            Command="{Binding DataContext.PickAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="Swatch" CornerRadius="7" Background="{Binding}" BorderBrush="{DynamicResource Brush.Edge}" BorderThickness="1" />
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Brush.Text}" />
                              <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- About -->
          <StackPanel Visibility="{Binding Section, Converter={StaticResource EqualsToVisibility}, ConverterParameter=about}">
            <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.about}" Margin="2,4,0,6" />
            <Border Style="{StaticResource Surface.Card}" Padding="16">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold">
                  <Run Text="bitBybit" />
                  <Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Text.Hint}" Text="{loc:T app.settings.aboutText}" Margin="0,6,0,0" />
                <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.dataFolders}" />
                <TextBlock Text="{Binding DataFolders}" FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Text.Section}" Text="{loc:T app.settings.credits}" />
                <TextBlock Style="{StaticResource Text.Hint}" Text="{loc:T app.settings.creditsText}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
