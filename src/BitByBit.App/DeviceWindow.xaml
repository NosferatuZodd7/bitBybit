<Window x:Class="BitByBit.App.DeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BitByBit.App.Infrastructure"
        xmlns:vm="clr-namespace:BitByBit.App.ViewModels"
        xmlns:t="clr-namespace:BitByBit.App.Theming"
        Title="{Binding Name}" Width="900" Height="720" MinWidth="720" MinHeight="520"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13" UseLayoutRounding="True" Icon="pack://application:,,,/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources>
    <DataTemplate x:Key="FieldTemplate" DataType="{x:Type vm:CardField}">
      <DockPanel Margin="0,3,0,0">
        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{DynamicResource Brush.TextMuted}" Width="150" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
      </DockPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <t:GlassBackdrop />
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20">
        <!-- Header: what the device is and its state -->
        <DockPanel Margin="0,0,0,14">
          <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource Brush.AccentFill}" Margin="0,0,14,0">
            <t:Icon Glyph="{Binding Glyph}" Size="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" t:Ux.Tone="{Binding StateTone}" VerticalAlignment="Center">
            <TextBlock Text="{Binding StateText}" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Name}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Subtitle}" />
          </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Banner}" t:Ux.Tone="Warn" Margin="0,0,0,12" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <t:Icon Glyph="warning" Size="16" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.Warn}" />
            <TextBlock Text="{loc:T devices.guard.protected}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
          </DockPanel>
        </Border>

        <!-- Device and driver facts -->
        <UniformGrid Columns="2" Margin="0,0,0,4">
          <Border Style="{StaticResource Surface.Card}" Padding="16,14" Margin="0,0,6,12">
            <StackPanel>
              <TextBlock Text="{loc:T app.device.section.device}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding DeviceFields}" ItemTemplate="{StaticResource FieldTemplate}" />
              <Button Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,10,0,0" Content="{loc:T app.device.copyId}" t:Ux.Icon="copy" Command="{Binding CopyInstanceIdCommand}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Surface.Card}" Padding="16,14" Margin="6,0,0,12">
            <StackPanel>
              <TextBlock Text="{loc:T app.device.section.driver}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding DriverFields}" ItemTemplate="{StaticResource FieldTemplate}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- Actions: each one says why it is offered or not, and its risk -->
        <TextBlock Text="{loc:T app.device.section.actions}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,8" />
        <ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceActionRow}">
              <Border x:Name="Row" Style="{StaticResource Surface.Card}" Padding="14,10" Margin="0,0,0,8">
                <DockPanel>
                  <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="170">
                    <Button Content="{Binding Title}" t:Ux.Icon="{Binding Glyph}" Command="{Binding Command}" HorizontalAlignment="Right"
                            Visibility="{Binding ShowNormal, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Danger}" Content="{Binding Title}" t:Ux.Icon="{Binding Glyph}" Command="{Binding Command}" HorizontalAlignment="Right"
                            Visibility="{Binding ShowDanger, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{StaticResource Tag}" HorizontalAlignment="Right" Visibility="{Binding IsAllowed, Converter={StaticResource InverseBoolToVisibility}}">
                      <TextBlock Text="{loc:T app.device.notAvailable}" />
                    </Border>
                  </Grid>
                  <StackPanel>
                    <TextBlock>
                      <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="{Binding Risk, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                  </StackPanel>
                </DockPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                  <Setter TargetName="Row" Property="Opacity" Value="0.72" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Compatible drivers already on this computer (loaded on request, read-only) -->
        <StackPanel Visibility="{Binding CanChangeDriver, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding DriversStatus}" Margin="2,0,0,8" TextWrapping="Wrap"
                     Visibility="{Binding DriversStatus, Converter={StaticResource EmptyToCollapsed}}" />
          <StackPanel Visibility="{Binding IsLoadingDrivers, Converter={StaticResource BoolToVisibility}}">
            <t:SkeletonRow />
            <t:SkeletonRow />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding DriverGroups}" ItemTemplate="{StaticResource CardGroupTemplate}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
