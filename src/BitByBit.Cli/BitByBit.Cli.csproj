<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line diagnostics: collects read-only evidence (devices, drivers, audio, display, network) into a
       redacted JSON/Markdown report. Also used as a smoke test on Windows CI runners. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(BitByBitWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(BitByBitMinWindows)</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>bitbybit-cli</AssemblyName>
    <RootNamespace>BitByBit.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BitByBit.Core\BitByBit.Core.csproj" />
    <ProjectReference Include="..\BitByBit.Platform.Windows\BitByBit.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
