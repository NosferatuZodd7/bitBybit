<Project Sdk="Microsoft.NET.Sdk">
  <!-- Release tooling: key generation, manifest creation and signing, verification. Runs in CI (any OS).
       The private key is read from an environment variable / file provided by GitHub Actions secrets; never committed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bitbybit-release</AssemblyName>
    <RootNamespace>BitByBit.ReleaseTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\BitByBit.Core\BitByBit.Core.csproj" />
  </ItemGroup>
</Project>
